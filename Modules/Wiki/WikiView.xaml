<UserControl
    x:Class="KubaToolKit.Modules.Wiki.WikiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.Wiki">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <ContextMenu x:Key="SectionRowContextMenu" Opened="SectionsContextMenu_Opened">
            <MenuItem Header="Add page above" Click="AddSectionAbove_Click"/>
            <MenuItem Header="Add page below" Click="AddSectionBelow_Click"/>
            <MenuItem x:Name="RenameMenuItem" Header="Rename" Click="RenameSection_Click"/>
            <Separator/>
            <MenuItem x:Name="DeleteMenuItem" Header="Delete" Click="DeleteSection_Click"/>
        </ContextMenu>

        <!-- The app-wide TextBox style fixes Height=30 and vertically
             centers its content, both meant for single-line inputs; this
             notes box needs to fill its row and start text at the top. -->
        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Margin="0,0,0,10">

            <TextBlock
                Text="Search"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextSecondaryBrush}"/>

            <TextBox
                x:Name="SearchTextBox"
                Width="260"
                VerticalContentAlignment="Center"
                KeyDown="SearchTextBox_KeyDown"
                ToolTip="Searches page names and text (Ctrl+F to focus). Enter = next result, Shift+Enter = previous."/>

            <Button
                Content="▲"
                Width="30"
                Padding="0"
                Margin="6,0,0,0"
                Click="SearchPreviousButton_Click"
                ToolTip="Previous result"/>

            <Button
                Content="▼"
                Width="30"
                Padding="0"
                Margin="4,0,0,0"
                Click="SearchNextButton_Click"
                ToolTip="Next result"/>

            <TextBlock
                x:Name="SearchResultsText"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                FontSize="11"
                Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pages -->
            <Border
                Grid.Column="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Pages"
                                FontWeight="Bold"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextPrimaryBrush}"/>

                            <Button
                                Grid.Column="1"
                                Content="A→Z"
                                Padding="6,0"
                                Margin="0,0,4,0"
                                FontSize="11"
                                Click="SortSectionsAscendingButton_Click"
                                ToolTip="Sort pages A to Z"/>

                            <Button
                                Grid.Column="2"
                                Content="Z→A"
                                Padding="6,0"
                                FontSize="11"
                                Click="SortSectionsDescendingButton_Click"
                                ToolTip="Sort pages Z to A"/>
                        </Grid>

                        <TextBox
                            x:Name="NewSectionNameTextBox"
                            Margin="0,0,0,6"
                            VerticalContentAlignment="Center"
                            ToolTip="Page name"
                            KeyDown="NewSectionNameTextBox_KeyDown"/>

                        <Button
                            Content="+ Add page"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddSectionButton_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SectionGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <Border
                                            Padding="4,6"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            MouseLeftButtonDown="FolderHeader_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding HeaderVisibility}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path
                                                    Grid.Column="0"
                                                    Data="M0,0 L4,4 L8,0"
                                                    Stroke="{StaticResource TextMutedBrush}"
                                                    StrokeThickness="1.6"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    Width="8" Height="8"
                                                    Margin="0,0,6,0"
                                                    RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="{Binding ChevronAngle}"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding FolderName}"
                                                    FontSize="10.5"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource TextMutedBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding RowsVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Padding="6,5"
                                                        CornerRadius="4"
                                                        Background="{Binding RowBackground}"
                                                        MouseLeftButtonDown="SectionRow_Click"
                                                        MouseRightButtonDown="SectionRow_Click"
                                                        Tag="{Binding}"
                                                        ContextMenu="{StaticResource SectionRowContextMenu}">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"/>

            <!-- Content -->
            <Border
                x:Name="ContentBorder"
                Grid.Column="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="14"
                Visibility="Collapsed">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock
                            Text="Folder"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"/>

                        <ComboBox
                            x:Name="SectionFolderCombo"
                            Width="220"
                            IsEditable="True"
                            Style="{StaticResource EditableComboBoxStyle}"
                            ToolTip="Group this page under a folder -- pick an existing one or type a new name, leave empty for no folder"
                            SelectionChanged="SectionFolderCombo_SelectionChanged"
                            LostFocus="SectionFolderCombo_LostFocus"/>
                    </StackPanel>

                    <TextBox
                        x:Name="ContentTextBox"
                        Grid.Row="1"
                        Style="{StaticResource MultilineTextBoxStyle}"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        FontSize="13"
                        TextChanged="ContentTextBox_TextChanged"/>

                    <Border
                        x:Name="FeaturedImageBorder"
                        Grid.Row="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceAltBrush}"
                        Visibility="Collapsed"
                        ClipToBounds="True">
                        <Grid>
                            <local:NoWheelScrollViewer
                                x:Name="FeaturedImageScrollViewer"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                ZoomWheel="FeaturedImageScrollViewer_ZoomWheel">
                                <Image
                                    x:Name="FeaturedImage"
                                    Stretch="Uniform"
                                    Margin="8"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="FeaturedImage_MouseLeftButtonDown"
                                    MouseMove="FeaturedImage_MouseMove"
                                    MouseLeftButtonUp="FeaturedImage_MouseLeftButtonUp"
                                    ToolTip="Scroll to zoom (Ctrl+Scroll to pan up/down), drag to pan, double-click to reset">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="FeaturedImageScale" ScaleX="1" ScaleY="1"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </local:NoWheelScrollViewer>
                            <TextBlock
                                x:Name="FeaturedImageEmptyText"
                                Text="No image attached yet -- add one below."
                                FontStyle="Italic"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextMutedBrush}"
                                Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Row="2"
                        Height="8"
                        HorizontalAlignment="Stretch"
                        ResizeBehavior="PreviousAndNext"
                        ToolTip="Drag to resize"/>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                x:Name="ImageOnlyCheckBox"
                                Grid.Column="0"
                                Content="Image only (hide notes, show the first image large)"
                                VerticalAlignment="Center"
                                Checked="ImageOnlyCheckBox_Changed"
                                Unchecked="ImageOnlyCheckBox_Changed"/>

                            <Button
                                Grid.Column="1"
                                Content="+ Add image / PDF"
                                Padding="10,2"
                                Click="AddImageButton_Click"/>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="ImagesPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock
                x:Name="NoSelectionText"
                Grid.Column="2"
                Text="Select or add a page on the left."
                FontStyle="Italic"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>
    </Grid>
</UserControl>
