<Window
    x:Class="KubaToolKit.Modules.KnowledgeSearch.AtlassianSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Jira / Confluence connection"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock
            Text="Cloud only (yourcompany.atlassian.net). Generate an API token at id.atlassian.com/manage-profile/security/api-tokens -- it's tied to your account, kept only on this machine, never committed."
            TextWrapping="Wrap"
            FontSize="11"
            Foreground="{StaticResource TextSecondaryBrush}"
            Margin="0,0,0,14"/>

        <TextBlock Text="Base URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox
            x:Name="BaseUrlTextBox"
            Margin="0,0,0,10"
            ToolTip="e.g. https://yourcompany.atlassian.net"/>

        <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailTextBox" Margin="0,0,0,10"/>

        <TextBlock Text="API token" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="ApiTokenTextBox" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button
                Content="Test connection"
                Width="130"
                Click="TestConnectionButton_Click"/>

            <TextBlock
                x:Name="TestResultText"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                FontSize="11"
                TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
