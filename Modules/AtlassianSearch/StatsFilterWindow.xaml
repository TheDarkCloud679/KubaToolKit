<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.StatsFilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Statistics filters"
    Width="480"
    SizeToContent="Height"
    MinWidth="440"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock
                Text="Statistics filters"
                FontWeight="Bold"
                FontSize="15"
                Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock
                Text="Applied to the next 'Run stats'"
                FontSize="11.5"
                Margin="0,2,0,0"
                Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Project" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="ProjectOperatorCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="not in"/>
                </ComboBox>
                <Button
                    x:Name="ProjectPickerButton"
                    Grid.Column="2"
                    Content="(Any)"
                    HorizontalContentAlignment="Left"
                    Padding="8,4"
                    Click="ProjectPickerButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Person" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="AssigneeOperatorCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="not in"/>
                </ComboBox>
                <Button
                    x:Name="AssigneePickerButton"
                    Grid.Column="2"
                    Content="(Any)"
                    HorizontalContentAlignment="Left"
                    Padding="8,4"
                    ToolTip="Includes yourself -- not every user may be listed"
                    Click="AssigneePickerButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="État" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="StatusOperatorCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="not in"/>
                </ComboBox>
                <Button
                    x:Name="StatusPickerButton"
                    Grid.Column="2"
                    Content="(Any)"
                    HorizontalContentAlignment="Left"
                    Padding="8,4"
                    Click="StatusPickerButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Module" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="ModuleOperatorCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="not in"/>
                </ComboBox>
                <Button
                    x:Name="ModulePickerButton"
                    Grid.Column="2"
                    Content="(Any)"
                    HorizontalContentAlignment="Left"
                    Padding="8,4"
                    ToolTip="'Component (migrated)' values"
                    Click="ModulePickerButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Escalade" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="EscalationOperatorCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="not in"/>
                </ComboBox>
                <Button
                    x:Name="EscalationPickerButton"
                    Grid.Column="2"
                    Content="(Any)"
                    HorizontalContentAlignment="Left"
                    Padding="8,4"
                    Click="EscalationPickerButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Type de demande" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="RequestTypeOperatorCombo" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="not in"/>
                </ComboBox>
                <Button
                    x:Name="RequestTypePickerButton"
                    Grid.Column="2"
                    Content="(Any)"
                    HorizontalContentAlignment="Left"
                    Padding="8,4"
                    ToolTip="'Request Type' values"
                    Click="RequestTypePickerButton_Click"/>
            </Grid>

            <Border
                Height="1"
                Margin="0,4,0,14"
                Background="{StaticResource BorderBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Resolved from" FontSize="11" Margin="0,0,0,2"/>
                    <DatePicker
                        x:Name="FromDatePicker"
                        ToolTip="Resolved on/after this date -- leave blank for no lower bound (only relevant when État includes resolved issues)"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Resolved to" FontSize="11" Margin="0,0,0,2"/>
                    <DatePicker
                        x:Name="ToDatePicker"
                        ToolTip="Resolved on/before this date (inclusive) -- leave blank for no upper bound (only relevant when État includes resolved issues)"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,18,0,0">
            <Button
                Content="Clear all"
                Width="90"
                Margin="0,0,8,0"
                Click="ClearAllButton_Click"/>
            <Button
                Content="Close"
                Width="90"
                Style="{StaticResource AccentButtonStyle}"
                Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
