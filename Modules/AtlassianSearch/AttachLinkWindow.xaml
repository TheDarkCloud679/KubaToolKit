<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.AttachLinkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.AtlassianSearch"
    Title="Link a ticket or page"
    Width="680"
    Height="620"
    MinWidth="560"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <local:JiraPriorityBadgeBackgroundConverter x:Key="JiraPriorityBadgeBackgroundConverter"/>
        <local:JiraPriorityBadgeForegroundConverter x:Key="JiraPriorityBadgeForegroundConverter"/>
        <local:JiraStatusBadgeBackgroundConverter x:Key="JiraStatusBadgeBackgroundConverter"/>
        <local:JiraStatusBadgeForegroundConverter x:Key="JiraStatusBadgeForegroundConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock
                Text="Link a ticket or page"
                FontWeight="Bold"
                FontSize="15"
                Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11.5"
                Margin="0,2,0,0"
                Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QueryTextBox"
                Grid.Column="0"
                VerticalContentAlignment="Center"
                ToolTip="Search Jira and Confluence by keyword -- Enter to search"
                KeyDown="QueryTextBox_KeyDown"/>

            <Button
                x:Name="SearchButton"
                Grid.Column="1"
                Width="90"
                Margin="8,0,0,0"
                Content="Search"
                Style="{StaticResource AccentButtonStyle}"
                Click="SearchButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <ComboBox
                x:Name="FilterSpaceCombo"
                Width="130"
                Margin="0,0,8,0"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                ToolTip="Filter Confluence results by space"
                SelectionChanged="FilterSpaceCombo_SelectionChanged"/>

            <ComboBox
                x:Name="FilterStatusCombo"
                Width="130"
                Margin="0,0,8,0"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                ToolTip="Filter Jira results by status"
                SelectionChanged="FilterStatusCombo_SelectionChanged"/>

            <DatePicker
                x:Name="FilterFromDatePicker"
                Width="112"
                Margin="0,0,4,0"
                ToolTip="Updated/modified on or after this date"
                SelectedDateChanged="FilterDatePicker_SelectedDateChanged"/>

            <DatePicker
                x:Name="FilterToDatePicker"
                Width="112"
                Margin="0,0,14,0"
                ToolTip="Updated/modified on or before this date"
                SelectedDateChanged="FilterDatePicker_SelectedDateChanged"/>

            <TextBlock Text="Date" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource TextMutedBrush}"/>

            <Button
                Content="▲"
                Width="26"
                Padding="0"
                FontSize="10"
                Margin="0,0,4,0"
                Click="SortDateAscendingButton_Click"
                ToolTip="Sort by date, oldest first"/>

            <Button
                Content="▼"
                Width="26"
                Padding="0"
                FontSize="10"
                Click="SortDateDescendingButton_Click"
                ToolTip="Sort by date, newest first"/>
        </StackPanel>

        <Border
            Grid.Row="3"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Padding="4">

            <Grid>
                <ProgressBar
                    x:Name="SearchProgressBar"
                    VerticalAlignment="Top"
                    Height="3"
                    Visibility="Collapsed"
                    IsIndeterminate="True"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsItemsControl" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="26"
                                            Height="26"
                                            Margin="0,0,10,0"
                                            CornerRadius="6"
                                            VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJira}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Path
                                                    Data="M3,8.5 A1.8,1.8 0 0 0 3,11.5 L3,12.5 A1.8,1.8 0 0 0 3,15.5 L3,19 L21,19 L21,15.5 A1.8,1.8 0 0 1 21,12.5 L21,11.5 A1.8,1.8 0 0 1 21,8.5 L21,5 L3,5 Z M12,6.5 L12,17.5"
                                                    Stroke="{StaticResource AccentPressedBrush}"
                                                    StrokeThickness="1.4"
                                                    StrokeDashArray="1.6,1.6"
                                                    Width="13" Height="13" Stretch="Uniform"
                                                    Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Path
                                                    Data="M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7 M8.5,12 L15.5,12 M8.5,15.5 L13.5,15.5"
                                                    Stroke="{StaticResource TextSecondaryBrush}"
                                                    StrokeThickness="1.4"
                                                    StrokeLineJoin="Round"
                                                    Width="13" Height="13" Stretch="Uniform"
                                                    Visibility="{Binding IsConfluence, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Text="{Binding Key}"
                                                    FontFamily="Cascadia Code, Consolas"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock
                                                    Text="{Binding Title}"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Margin="0,2,0,0">
                                                <Run Text="{Binding Subtitle}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding DisplayDate}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border
                                                Background="{Binding Priority, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    Text="{Binding Priority}"
                                                    FontSize="10.5"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding Priority, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                                            </Border>
                                            <Border
                                                Background="{Binding Status, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontSize="10.5"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding Status, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                                            </Border>

                                            <Button
                                                Width="80"
                                                Content="Attach"
                                                Click="Attach_Click"
                                                Visibility="{Binding IsAttached, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            <Border
                                                Width="80"
                                                Padding="0,5"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Background="{StaticResource SuccessSoftBrush}"
                                                Visibility="{Binding IsAttached, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock
                                                    Text="Linked"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    x:Name="EmptyStateText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontStyle="Italic"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="Search Jira and Confluence by keyword above."/>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0">
            <Button
                Width="100"
                Content="Close"
                Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
