<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.MultiSelectPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select"
    Width="340"
    Height="460"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="0"
            Margin="0,0,0,8"
            VerticalContentAlignment="Center"
            ToolTip="Type to filter -- click (ctrl/shift-click for more) to select"
            TextChanged="SearchBox_TextChanged"/>

        <ListBox
            x:Name="OptionsListBox"
            Grid.Row="1"
            SelectionMode="Multiple"
            DisplayMemberPath="Display"
            MouseDoubleClick="OptionsListBox_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Clear" Width="80" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
