<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.JiraIssueViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.AtlassianSearch"
    Title="Jira issue"
    Width="820"
    Height="760"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:JiraPriorityBadgeBackgroundConverter x:Key="JiraPriorityBadgeBackgroundConverter"/>
        <local:JiraPriorityBadgeForegroundConverter x:Key="JiraPriorityBadgeForegroundConverter"/>
        <local:JiraStatusBadgeBackgroundConverter x:Key="JiraStatusBadgeBackgroundConverter"/>
        <local:JiraStatusBadgeForegroundConverter x:Key="JiraStatusBadgeForegroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:CommentVisibilityBackgroundConverter x:Key="CommentVisibilityBackgroundConverter"/>
        <local:CommentVisibilityForegroundConverter x:Key="CommentVisibilityForegroundConverter"/>
        <local:CommentVisibilityTextConverter x:Key="CommentVisibilityTextConverter"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="KeyText" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                    <Border
                        x:Name="PriorityBadge"
                        Background="{Binding Text, ElementName=PriorityBadgeText, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                        CornerRadius="3"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PriorityBadgeText"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{Binding Text, ElementName=PriorityBadgeText, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                    </Border>

                    <Border
                        x:Name="StatusBadge"
                        Background="{Binding Text, ElementName=StatusBadgeText, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                        CornerRadius="3"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="StatusBadgeText"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{Binding Text, ElementName=StatusBadgeText, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SummaryText" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Button
                x:Name="OpenInBrowserButton"
                Grid.Column="1"
                Content="Open in browser"
                Width="130"
                VerticalAlignment="Top"
                Click="OpenInBrowserButton_Click"/>
        </Grid>

        <!-- Assignee / Status editing -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Assignee" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="AssigneeSearchBox" ToolTip="Type to search assignable users"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="AssigneeCombo"
                        Grid.Column="0"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"/>
                    <Button
                        Grid.Column="1"
                        Content="Apply"
                        Margin="6,0,0,0"
                        Click="ApplyAssigneeButton_Click"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Status" FontSize="11" Margin="0,0,0,2"/>
                <TextBlock Text=" " FontSize="11"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="StatusCombo"
                        Grid.Column="0"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"
                        ToolTip="Only transitions actually available from the current status are listed"/>
                    <Button
                        Grid.Column="1"
                        Content="Apply"
                        Margin="6,0,0,0"
                        Click="ApplyStatusButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>

        <TextBlock
            x:Name="StatusMessageText"
            Grid.Row="2"
            FontSize="11"
            Margin="0,0,0,8"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"/>

        <!-- Description -->
        <Grid Grid.Row="3">
            <TextBlock
                x:Name="DescriptionStatusText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="Loading..."/>
            <WebBrowser x:Name="DescriptionBrowser" Visibility="Collapsed"/>
        </Grid>

        <GridSplitter
            Grid.Row="4"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ResizeBehavior="PreviousAndNext"/>

        <!-- Comments -->
        <Border
            Grid.Row="5"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CommentsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,2">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding Created}" FontSize="11" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasVisibilityInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{Binding IsPublic, Converter={StaticResource CommentVisibilityBackgroundConverter}}">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Text="{Binding IsPublic, Converter={StaticResource CommentVisibilityTextConverter}}"
                                                Foreground="{Binding IsPublic, Converter={StaticResource CommentVisibilityForegroundConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- New comment -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox
                x:Name="NewCommentTextBox"
                Grid.Row="0"
                Height="60"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                ToolTip="Write a comment"/>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="VisibilityPanel"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <RadioButton x:Name="InternalOnlyRadio" Content="Internal only" IsChecked="True" GroupName="CommentVisibility" Margin="0,0,14,0"/>
                    <RadioButton x:Name="VisibleToCustomerRadio" Content="Visible to customer" GroupName="CommentVisibility"/>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="Add comment"
                    Width="120"
                    Click="AddCommentButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
