<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.JiraIssueViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.AtlassianSearch"
    Title="Jira issue"
    Width="860"
    Height="800"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <local:JiraPriorityBadgeBackgroundConverter x:Key="JiraPriorityBadgeBackgroundConverter"/>
        <local:JiraPriorityBadgeForegroundConverter x:Key="JiraPriorityBadgeForegroundConverter"/>
        <local:JiraStatusBadgeBackgroundConverter x:Key="JiraStatusBadgeBackgroundConverter"/>
        <local:JiraStatusBadgeForegroundConverter x:Key="JiraStatusBadgeForegroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:CommentVisibilityBackgroundConverter x:Key="CommentVisibilityBackgroundConverter"/>
        <local:CommentVisibilityForegroundConverter x:Key="CommentVisibilityForegroundConverter"/>
        <local:CommentVisibilityTextConverter x:Key="CommentVisibilityTextConverter"/>
        <local:InitialLetterConverter x:Key="InitialLetterConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="40" Height="40"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource AccentGradientBrush}">
                    <Path
                        Data="M3,8.5 A1.8,1.8 0 0 0 3,11.5 L3,12.5 A1.8,1.8 0 0 0 3,15.5 L3,19 L21,19 L21,15.5 A1.8,1.8 0 0 1 21,12.5 L21,11.5 A1.8,1.8 0 0 1 21,8.5 L21,5 L3,5 Z M12,6.5 L12,17.5"
                        Stroke="{StaticResource TextOnAccentBrush}"
                        StrokeThickness="1.5"
                        Width="18" Height="18" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="KeyText"
                            FontFamily="Cascadia Code, Consolas"
                            FontWeight="Bold"
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Center"/>

                        <Border
                            x:Name="PriorityBadge"
                            Background="{Binding Text, ElementName=PriorityBadgeText, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PriorityBadgeText"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{Binding Text, ElementName=PriorityBadgeText, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                        </Border>

                        <Border
                            x:Name="StatusBadge"
                            Background="{Binding Text, ElementName=StatusBadgeText, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="StatusBadgeText"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{Binding Text, ElementName=StatusBadgeText, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="SummaryText"
                        FontWeight="Bold"
                        FontSize="18"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            x:Name="RefreshButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Refresh"
                            Width="76"
                            Click="RefreshButton_Click"/>

                        <Button
                            x:Name="OpenInBrowserButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Open in browser"
                            Width="130"
                            Margin="8,0,0,0"
                            Click="OpenInBrowserButton_Click"/>
                    </StackPanel>

                    <TextBlock
                        x:Name="ConnectedAsText"
                        FontSize="11"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Assignee / Status editing -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ASSIGNEE" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="CurrentAssigneeText" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox x:Name="AssigneeSearchBox" ToolTip="Type to search assignable users"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="AssigneeCombo"
                            Grid.Column="0"
                            DisplayMemberPath="Display"
                            SelectedValuePath="Value"/>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Apply"
                            Margin="6,0,0,0"
                            Click="ApplyAssigneeButton_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="STATUS" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text=" " FontSize="13.5" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="StatusCombo"
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Id"
                            SelectionChanged="StatusCombo_SelectionChanged"
                            ToolTip="Only transitions actually available from the current status are listed"/>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Apply"
                            Margin="6,0,0,0"
                            Click="ApplyStatusButton_Click"/>
                    </Grid>

                    <!-- A capped, independently-scrolling height here, rather
                         than letting this grow freely, keeps however many
                         required fields a transition (or its editmeta/error-text
                         fallbacks) turns up from squeezing the rows below out of
                         this fixed-height window. -->
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl x:Name="RequiredFieldsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,0,0,2" Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox
                                            ItemsSource="{Binding AllowedValues}"
                                            DisplayMemberPath="Display"
                                            SelectedValuePath="Value"
                                            SelectedValue="{Binding EnteredValue, Mode=TwoWay}"
                                            Visibility="{Binding HasAllowedValues, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBox
                                            Text="{Binding EnteredValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding HasAllowedValues, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            x:Name="StatusMessageText"
            Grid.Row="2"
            FontSize="11.5"
            Margin="4,0,0,10"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"/>

        <!-- Description -->
        <Border
            Grid.Row="3"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <TextBlock
                    x:Name="DescriptionStatusText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Loading..."/>
                <WebBrowser x:Name="DescriptionBrowser" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <GridSplitter
            Grid.Row="4"
            Height="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ResizeBehavior="PreviousAndNext"/>

        <!-- Comments -->
        <Border
            Grid.Row="5"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Comments"
                    FontWeight="Bold"
                    FontSize="13"
                    Margin="0,0,0,10"
                    Foreground="{StaticResource TextPrimaryBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommentsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="30" Height="30"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            CornerRadius="15"
                                            Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock
                                                Text="{Binding Author, Converter={StaticResource InitialLetterConverter}}"
                                                FontWeight="Bold"
                                                FontSize="12.5"
                                                Foreground="{StaticResource AccentPressedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Created}" FontSize="11" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <Border
                                                    Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasVisibilityInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{Binding IsPublic, Converter={StaticResource CommentVisibilityBackgroundConverter}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Text="{Binding IsPublic, Converter={StaticResource CommentVisibilityTextConverter}}"
                                                        Foreground="{Binding IsPublic, Converter={StaticResource CommentVisibilityForegroundConverter}}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- New comment -->
        <Border
            Grid.Row="6"
            Margin="0,10,0,0"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="NewCommentTextBox"
                    Grid.Row="0"
                    Height="60"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    ToolTip="Write a comment -- type @Name to mention one of this issue's assignable users"/>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="VisibilityPanel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <RadioButton x:Name="InternalOnlyRadio" Content="Internal only" IsChecked="True" GroupName="CommentVisibility" Margin="0,0,14,0"/>
                        <RadioButton x:Name="VisibleToCustomerRadio" Content="Visible to customer" GroupName="CommentVisibility"/>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Add comment"
                        Width="120"
                        Click="AddCommentButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
