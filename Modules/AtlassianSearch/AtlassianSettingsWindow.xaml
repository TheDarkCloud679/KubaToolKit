<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.AtlassianSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Jira / Confluence connection"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock Text="Base URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox
            x:Name="BaseUrlTextBox"
            Margin="0,0,0,10"
            ToolTip="e.g. https://yourcompany.atlassian.net (cloud only)"/>

        <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailTextBox" Margin="0,0,0,10"/>

        <TextBlock
            Text="API token"
            FontWeight="SemiBold"
            Margin="0,0,0,4"
            ToolTip="Generate one at id.atlassian.com/manage-profile/security/api-tokens — tied to your account, kept only on this machine, never committed."/>
        <TextBox x:Name="ApiTokenTextBox" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button
                Content="Test connection"
                Width="130"
                Click="TestConnectionButton_Click"/>

            <TextBlock
                x:Name="TestResultText"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                FontSize="11"
                TextWrapping="Wrap"/>
        </StackPanel>

        <Border Height="1" Margin="0,0,0,16" Background="{StaticResource BorderBrush}"/>

        <TextBlock
            Text="Shared Library folder (optional)"
            FontWeight="SemiBold"
            Margin="0,0,0,4"/>
        <TextBlock
            Text="Point this at a folder a sync tool already keeps up to date (Google Drive, OneDrive...) to share the incident Library with your team automatically. Leave empty to keep it on this machine only."
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,6"
            Foreground="{StaticResource TextMutedBrush}"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SharedLibraryFolderTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button
                Grid.Column="1"
                Content="Browse..."
                Width="90"
                Click="BrowseSharedLibraryFolderButton_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
