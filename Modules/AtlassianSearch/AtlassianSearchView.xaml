<UserControl
    x:Class="KubaToolKit.Modules.AtlassianSearch.AtlassianSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Atlassian Search"
                FontWeight="Bold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"
                VerticalAlignment="Center"/>

            <ProgressBar
                x:Name="LoadingProgressBar"
                Grid.Column="1"
                Margin="16,0"
                Visibility="Collapsed"
                IsIndeterminate="True"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="QueryTextBox"
                Grid.Column="2"
                Width="320"
                VerticalContentAlignment="Center"
                ToolTip="Search term (e.g. an error message or a component name) -- Enter to search"
                KeyDown="QueryTextBox_KeyDown"/>

            <Button
                x:Name="SearchButton"
                Grid.Column="3"
                Width="90"
                Margin="8,0,0,0"
                Content="Search"
                Style="{StaticResource AccentButtonStyle}"
                Click="SearchButton_Click"/>

            <Button
                x:Name="SettingsButton"
                Grid.Column="4"
                Width="90"
                Margin="8,0,0,0"
                Content="Settings"
                Click="SettingsButton_Click"/>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            FontSize="11"
            Margin="0,0,0,10"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"/>

        <!-- Results -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ConfluenceRow" Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="JiraRow" Height="*"/>
            </Grid.RowDefinitions>

            <!-- Confluence -->
            <Border
                Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Confluence pages"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Margin="0,0,0,8"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">

                        <StackPanel Width="140" Margin="0,0,14,0">
                            <TextBlock Text="Space" FontSize="11" Margin="0,0,0,2"/>
                            <Button
                                x:Name="ConfluenceSpaceButton"
                                Content="(Any)"
                                HorizontalContentAlignment="Left"
                                Padding="8,4"
                                ToolTip="Pick one or more Confluence spaces (favorites listed first, right-click to favorite)"
                                Click="ConfluenceSpaceButton_Click"/>
                        </StackPanel>

                        <StackPanel Width="160" Margin="0,0,14,0">
                            <TextBlock Text="Group" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="ConfluenceGroupSearchBox" ToolTip="Type to search top-level pages"/>
                            <ComboBox
                                x:Name="ConfluenceGroupCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"
                                ToolTip="Top-level page of the space"
                                SelectionChanged="ConfluenceGroupCombo_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Width="160">
                            <TextBlock Text="Page" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="ConfluencePageSearchBox" ToolTip="Type to search pages"/>
                            <ComboBox
                                x:Name="ConfluencePageCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"
                                ToolTip="Page inside the selected group"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid
                        x:Name="ConfluenceGrid"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        RowHeight="44"
                        MouseDoubleClick="ConfluenceGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Title"
                                Binding="{Binding Title}"
                                SortMemberPath="Title"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Space"
                                Binding="{Binding Space}"
                                SortMemberPath="Space"
                                Width="Auto"/>

                            <DataGridTextColumn
                                Header="Excerpt"
                                Binding="{Binding Excerpt}"
                                SortMemberPath="Excerpt"
                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Excerpt}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Content="Open"
                                            Width="70"
                                            Click="OpenConfluenceResult_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Row="1"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                ResizeBehavior="PreviousAndNext"/>

            <!-- Jira -->
            <Border
                Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Jira issues"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Margin="0,0,0,8"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">

                        <StackPanel Width="140" Margin="0,0,14,0">
                            <TextBlock Text="Project" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="JiraProjectSearchBox" ToolTip="Type to search projects"/>
                            <ComboBox
                                x:Name="JiraProjectCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"/>
                        </StackPanel>

                        <StackPanel Width="140" Margin="0,0,14,0">
                            <TextBlock Text="Reporter" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox
                                x:Name="JiraReporterSearchBox"
                                ToolTip="Type to search, or type a name and leave it unpicked -- not every user may be listed"/>
                            <ComboBox
                                x:Name="JiraReporterCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"/>
                        </StackPanel>

                        <StackPanel Width="140" Margin="0,0,14,0">
                            <TextBlock Text="Assignee" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox
                                x:Name="JiraAssigneeSearchBox"
                                ToolTip="Type to search, or type a name and leave it unpicked -- not every user may be listed"/>
                            <ComboBox
                                x:Name="JiraAssigneeCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"/>
                        </StackPanel>

                        <StackPanel Width="110" Margin="0,0,14,0">
                            <TextBlock Text="Priority" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="JiraPrioritySearchBox" ToolTip="Type to search"/>
                            <ComboBox
                                x:Name="JiraPriorityCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"/>
                        </StackPanel>

                        <StackPanel Width="130">
                            <TextBlock Text="Status" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="JiraStatusSearchBox" ToolTip="Type to search"/>
                            <ComboBox
                                x:Name="JiraStatusCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid
                        x:Name="JiraGrid"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        RowHeight="40"
                        MouseDoubleClick="JiraGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" SortMemberPath="Key" Width="Auto"/>

                            <DataGridTextColumn
                                Header="Summary"
                                Binding="{Binding Summary}"
                                SortMemberPath="Summary"
                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" SortMemberPath="Priority" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="Auto"/>
                            <DataGridTextColumn Header="Reporter" Binding="{Binding Reporter}" SortMemberPath="Reporter" Width="*"/>
                            <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" SortMemberPath="Assignee" Width="*"/>

                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Content="Open"
                                            Width="70"
                                            Click="OpenJiraResult_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
