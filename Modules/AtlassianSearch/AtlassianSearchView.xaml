<UserControl
    x:Class="KubaToolKit.Modules.AtlassianSearch.AtlassianSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.AtlassianSearch">

    <UserControl.Resources>
        <local:JiraPriorityBadgeBackgroundConverter x:Key="JiraPriorityBadgeBackgroundConverter"/>
        <local:JiraPriorityBadgeForegroundConverter x:Key="JiraPriorityBadgeForegroundConverter"/>
        <local:JiraStatusBadgeBackgroundConverter x:Key="JiraStatusBadgeBackgroundConverter"/>
        <local:JiraStatusBadgeForegroundConverter x:Key="JiraStatusBadgeForegroundConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border
                        Width="30" Height="30" Margin="0,0,10,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource AccentGradientBrush}">
                        <Path
                            Data="M4,5 C4,4.4 4.4,4 5,4 L11,4 L11,20 L5,20 C4.4,20 4,19.6 4,19 Z M20,5 C20,4.4 19.6,4 19,4 L13,4 L13,20 L19,20 C19.6,20 20,19.6 20,19 Z"
                            Stroke="{StaticResource TextOnAccentBrush}"
                            StrokeThickness="1.4" StrokeLineJoin="Round"
                            Width="15" Height="15" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="Atlassian"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock
                            Text="Knowledge base for Jira &amp; Confluence"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Margin="20,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Visibility="Collapsed"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <StackPanel
                    x:Name="ProfilePickerPanel"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Margin="0,0,10,0"
                    Visibility="Collapsed">
                    <TextBlock
                        Text="Profile"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox
                        x:Name="ProjectInfoProfileCombo"
                        Width="160"
                        ToolTip="AWS profile Project Info is scoped to"
                        SelectionChanged="ProjectInfoProfileCombo_SelectionChanged"/>
                </StackPanel>

                <Button
                    x:Name="SettingsButton"
                    Grid.Column="3"
                    Width="90"
                    Content="Settings"
                    Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- Tab strip -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton
                x:Name="LibraryTabRadio"
                Content="Library"
                GroupName="AtlassianTab"
                IsChecked="True"
                Checked="AtlassianTab_Changed"
                Style="{StaticResource RequestTabRadioButtonStyle}"/>
            <RadioButton
                x:Name="WikiTabRadio"
                Content="Wiki"
                GroupName="AtlassianTab"
                Checked="AtlassianTab_Changed"
                Style="{StaticResource RequestTabRadioButtonStyle}"/>
            <RadioButton
                x:Name="ProjectInfoTabRadio"
                Content="Project Info"
                GroupName="AtlassianTab"
                Checked="AtlassianTab_Changed"
                Style="{StaticResource RequestTabRadioButtonStyle}"/>
            <RadioButton
                x:Name="StatsTabRadio"
                Content="Statistics"
                GroupName="AtlassianTab"
                Checked="AtlassianTab_Changed"
                Style="{StaticResource RequestTabRadioButtonStyle}"/>
        </StackPanel>

        <!-- ===================================================== -->
        <!-- LIBRARY TAB -->
        <!-- ===================================================== -->
        <Grid x:Name="LibraryTabContent" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Incidents -->
            <Border
                Grid.Column="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPaddingCompact}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border
                                Width="24" Height="24"
                                Margin="0,0,8,0"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Background="{StaticResource AccentGradientBrush}">
                                <Path
                                    Data="M12,3 L22,20 L2,20 Z M12,9 L12,14.5 M12,17 A1,1 0 1 0 12,17.01"
                                    Stroke="{StaticResource TextOnAccentBrush}"
                                    StrokeThickness="1.6" StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="12" Height="12" Stretch="Uniform"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock
                                Text="Incidents"
                                FontWeight="Bold"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Style="{StaticResource IconChevronButtonStyle}"
                                Width="24" Height="24"
                                Margin="0,0,4,0"
                                ToolTip="Export the whole library to a JSON file, to share or back up"
                                Click="ExportLibraryButton_Click">
                                <Path
                                    Data="M12,3 L12,14 M7.5,9.5 L12,14 L16.5,9.5 M4,18 L20,18"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.6" StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <Button
                                Style="{StaticResource IconChevronButtonStyle}"
                                Width="24" Height="24"
                                Margin="0,0,8,0"
                                ToolTip="Import a library JSON file someone shared -- added alongside what's already here"
                                Click="ImportLibraryButton_Click">
                                <Path
                                    Data="M12,14 L12,3 M7.5,7.5 L12,3 L16.5,7.5 M4,18 L20,18"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.6" StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="10,0"
                                Height="26"
                                FontSize="11.5"
                                Content="+ New"
                                Click="NewIncident_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">
                        <Grid>
                            <Path
                                Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16,16 L21,21"
                                Stroke="{StaticResource TextMutedBrush}"
                                StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                Width="12" Height="12" Stretch="Uniform"
                                HorizontalAlignment="Left"
                                Margin="8,0,0,0"/>
                            <TextBox
                                x:Name="IncidentSearchBox"
                                BorderThickness="0"
                                Padding="26,0,6,0"
                                ToolTip="Search incidents by name"
                                TextChanged="IncidentSearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IncidentListItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="12,10"
                                        Margin="0,0,0,8"
                                        BorderThickness="1"
                                        BorderBrush="{Binding RowBorderBrush}"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{Binding RowBackground}"
                                        Effect="{StaticResource CardShadowEffect}"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="IncidentRow_MouseLeftButtonDown"
                                        Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    FontSize="12.5"
                                                    TextTrimming="CharacterEllipsis"/>
                                                <TextBlock
                                                    Text="{Binding CountLabel}"
                                                    FontSize="10.5"
                                                    Margin="0,2,0,0"
                                                    Foreground="{Binding CountForeground}"/>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Style="{StaticResource IconChevronButtonStyle}"
                                                Width="22" Height="22"
                                                ToolTip="Delete this incident"
                                                Click="DeleteIncident_Click"
                                                Tag="{Binding}">
                                                <Path
                                                    Data="M6,6 L18,18 M18,6 L6,18"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                    Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"/>

            <!-- Incident detail -->
            <Border
                Grid.Column="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <Grid>
                    <StackPanel x:Name="NoIncidentSelectedPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock
                            Text="Select an incident on the left, or create a new one."
                            FontSize="13"
                            Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <Grid x:Name="IncidentDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="34" Height="34"
                                Margin="0,0,12,0"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{StaticResource AccentGradientBrush}">
                                <Path
                                    Data="M12,3 L22,20 L2,20 Z M12,9 L12,14.5 M12,17 A1,1 0 1 0 12,17.01"
                                    Stroke="{StaticResource TextOnAccentBrush}"
                                    StrokeThickness="1.5" StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="16" Height="16" Stretch="Uniform"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBox
                                    x:Name="IncidentNameTextBox"
                                    BorderThickness="0"
                                    Padding="0"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Background="Transparent"
                                    LostFocus="IncidentNameTextBox_LostFocus"/>

                                <TextBox
                                    x:Name="IncidentDescriptionTextBox"
                                    Margin="0,3,0,0"
                                    BorderThickness="0"
                                    Padding="0"
                                    FontSize="12.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Background="Transparent"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="Auto"
                                    MaxHeight="54"
                                    VerticalScrollBarVisibility="Auto"
                                    LostFocus="IncidentDescriptionTextBox_LostFocus"/>
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Margin="0,10,0,10"
                            Background="{StaticResource BorderBrush}"/>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="LinkCountText"
                                    Grid.Column="0"
                                    FontWeight="Bold"
                                    FontSize="12.5"
                                    VerticalAlignment="Center"/>

                                <TextBox
                                    x:Name="LinksSearchBox"
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="0,0,8,0"
                                    ToolTip="Search a word in the linked tickets/pages"
                                    TextChanged="LinksSearchBox_TextChanged"/>

                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Link an item"
                                    Click="AttachLink_Click"/>
                            </Grid>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox
                                    x:Name="LinkShowJiraCheckBox"
                                    Content="Jira"
                                    IsChecked="True"
                                    Margin="0,0,12,4"
                                    VerticalAlignment="Center"
                                    Checked="LinkTypeFilterCheckBox_Changed"
                                    Unchecked="LinkTypeFilterCheckBox_Changed"/>

                                <CheckBox
                                    x:Name="LinkShowConfluenceCheckBox"
                                    Content="Confluence"
                                    IsChecked="True"
                                    Margin="0,0,14,4"
                                    VerticalAlignment="Center"
                                    Checked="LinkTypeFilterCheckBox_Changed"
                                    Unchecked="LinkTypeFilterCheckBox_Changed"/>

                                <ComboBox
                                    x:Name="LinkFilterProjectCombo"
                                    Width="110"
                                    Margin="0,0,8,4"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    ToolTip="Filter Jira tickets by project"
                                    SelectionChanged="LinkFilterProjectCombo_SelectionChanged"/>

                                <ComboBox
                                    x:Name="LinkFilterSpaceCombo"
                                    Width="110"
                                    Margin="0,0,8,4"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    ToolTip="Filter Confluence pages by space"
                                    SelectionChanged="LinkFilterSpaceCombo_SelectionChanged"/>

                                <ComboBox
                                    x:Name="LinkFilterStatusCombo"
                                    Width="110"
                                    Margin="0,0,14,4"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    ToolTip="Filter Jira tickets by status"
                                    SelectionChanged="LinkFilterStatusCombo_SelectionChanged"/>

                                <DatePicker
                                    x:Name="LinkFilterFromDatePicker"
                                    Width="106"
                                    Margin="0,0,4,4"
                                    ToolTip="Updated/modified on or after this date"
                                    SelectedDateChanged="LinkFilterDatePicker_SelectedDateChanged"/>

                                <DatePicker
                                    x:Name="LinkFilterToDatePicker"
                                    Width="106"
                                    Margin="0,0,14,4"
                                    ToolTip="Updated/modified on or before this date"
                                    SelectedDateChanged="LinkFilterDatePicker_SelectedDateChanged"/>

                                <TextBlock Text="Date" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,4" Foreground="{StaticResource TextMutedBrush}"/>

                                <Button
                                    Content="▲"
                                    Width="26"
                                    Padding="0"
                                    FontSize="10"
                                    Margin="0,0,4,4"
                                    Click="LinkSortDateAscendingButton_Click"
                                    ToolTip="Sort by date, oldest first"/>

                                <Button
                                    Content="▼"
                                    Width="26"
                                    Padding="0"
                                    FontSize="10"
                                    Margin="0,0,0,4"
                                    Click="LinkSortDateDescendingButton_Click"
                                    ToolTip="Sort by date, newest first"/>
                            </WrapPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl x:Name="LinksItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="10,8"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="LinkRow_MouseLeftButtonDown"
                                                    Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Grid.Column="0"
                                                            Width="26"
                                                            Height="26"
                                                            Margin="0,0,10,0"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource AccentSoftBrush}">
                                                            <Grid>
                                                                <Path
                                                                    Data="M3,8.5 A1.8,1.8 0 0 0 3,11.5 L3,12.5 A1.8,1.8 0 0 0 3,15.5 L3,19 L21,19 L21,15.5 A1.8,1.8 0 0 1 21,12.5 L21,11.5 A1.8,1.8 0 0 1 21,8.5 L21,5 L3,5 Z M12,6.5 L12,17.5"
                                                                    Stroke="{StaticResource AccentPressedBrush}"
                                                                    StrokeThickness="1.4"
                                                                    StrokeDashArray="1.6,1.6"
                                                                    Width="13" Height="13" Stretch="Uniform"
                                                                    Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <Path
                                                                    Data="M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7 M8.5,12 L15.5,12 M8.5,15.5 L13.5,15.5"
                                                                    Stroke="{StaticResource TextSecondaryBrush}"
                                                                    StrokeThickness="1.4"
                                                                    StrokeLineJoin="Round"
                                                                    Width="13" Height="13" Stretch="Uniform"
                                                                    Visibility="{Binding IsConfluence, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    Text="{Binding Key}"
                                                                    FontFamily="Cascadia Code, Consolas"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Margin="0,0,8,0"
                                                                    Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <TextBlock
                                                                    Text="{Binding Title}"
                                                                    FontSize="12.5"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                Margin="0,2,0,0">
                                                                <Run Text="{Binding Subtitle}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding DisplayDate}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border
                                                                Background="{Binding Priority, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock
                                                                    Text="{Binding Priority}"
                                                                    FontSize="10.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Priority, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                                                            </Border>
                                                            <Border
                                                                Background="{Binding Status, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="0,0,8,0"
                                                                Visibility="{Binding IsJira, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock
                                                                    Text="{Binding Status}"
                                                                    FontSize="10.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{Binding Status, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                                                            </Border>
                                                            <Button
                                                                Style="{StaticResource IconChevronButtonStyle}"
                                                                Width="24" Height="24"
                                                                ToolTip="Unlink"
                                                                Click="Unlink_Click"
                                                                Tag="{Binding}">
                                                                <Path
                                                                    Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M8.5,12 L15.5,12"
                                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                    StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                                    Width="12" Height="12" Stretch="Uniform"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        x:Name="NoLinksText"
                                        FontSize="12.5"
                                        FontStyle="Italic"
                                        HorizontalAlignment="Center"
                                        Margin="0,24,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <GridSplitter
                            Grid.Row="3"
                            Height="8"
                            HorizontalAlignment="Stretch"
                            ResizeBehavior="PreviousAndNext"
                            ToolTip="Drag to resize"/>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Text="Solution"
                                FontWeight="Bold"
                                FontSize="12.5"
                                Margin="0,0,0,6"
                                Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBox
                                x:Name="IncidentSolutionTextBox"
                                Grid.Row="1"
                                Style="{StaticResource MultilineTextBoxStyle}"
                                AcceptsReturn="True"
                                AcceptsTab="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                FontSize="12.5"
                                Padding="8,6,8,6"
                                ToolTip="What actually fixed it, for next time"
                                LostFocus="IncidentSolutionTextBox_LostFocus"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================== -->
        <!-- STATISTICS TAB -->
        <!-- ===================================================== -->
        <Border
            x:Name="StatsTabContent"
            Grid.Row="2"
            Visibility="Collapsed"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Saved list" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox
                        x:Name="StatsSavedFilterCombo"
                        Width="200"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"
                        ToolTip="A saved combination of the filters below"
                        SelectionChanged="StatsSavedFilterCombo_SelectionChanged"/>
                    <Button
                        x:Name="SaveStatsFilterButton"
                        Content="Save current..."
                        Width="110"
                        Margin="8,0,0,0"
                        Click="SaveStatsFilterButton_Click"/>
                    <Button
                        x:Name="DeleteStatsFilterButton"
                        Content="Delete"
                        Width="70"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="DeleteStatsFilterButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">

                    <StackPanel Width="170" Margin="0,0,14,0">
                        <TextBlock Text="Project" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StatsProjectOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                <ComboBoxItem Content="in"/>
                                <ComboBoxItem Content="not in"/>
                            </ComboBox>
                            <Button
                                x:Name="StatsProjectPickerButton"
                                Content="(Any)"
                                Width="111"
                                HorizontalContentAlignment="Left"
                                Padding="8,4"
                                Click="StatsProjectPickerButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Width="220" Margin="0,0,14,0">
                        <TextBlock Text="Person" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StatsAssigneeOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                <ComboBoxItem Content="in"/>
                                <ComboBoxItem Content="not in"/>
                            </ComboBox>
                            <Button
                                x:Name="StatsAssigneePickerButton"
                                Content="(Any)"
                                Width="161"
                                HorizontalContentAlignment="Left"
                                Padding="8,4"
                                ToolTip="Includes yourself -- not every user may be listed"
                                Click="StatsAssigneePickerButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Width="170" Margin="0,0,14,0">
                        <TextBlock Text="État" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StatsStatusOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                <ComboBoxItem Content="in"/>
                                <ComboBoxItem Content="not in"/>
                            </ComboBox>
                            <Button
                                x:Name="StatsStatusPickerButton"
                                Content="(Any)"
                                Width="111"
                                HorizontalContentAlignment="Left"
                                Padding="8,4"
                                Click="StatsStatusPickerButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">

                    <StackPanel Width="170" Margin="0,0,14,0">
                        <TextBlock Text="Module" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StatsModuleOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                <ComboBoxItem Content="in"/>
                                <ComboBoxItem Content="not in"/>
                            </ComboBox>
                            <Button
                                x:Name="StatsModulePickerButton"
                                Content="(Any)"
                                Width="111"
                                HorizontalContentAlignment="Left"
                                Padding="8,4"
                                ToolTip="'Component (migrated)' values"
                                Click="StatsModulePickerButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Width="170" Margin="0,0,14,0">
                        <TextBlock Text="Escalade" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StatsEscalationOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                <ComboBoxItem Content="in"/>
                                <ComboBoxItem Content="not in"/>
                            </ComboBox>
                            <Button
                                x:Name="StatsEscalationPickerButton"
                                Content="(Any)"
                                Width="111"
                                HorizontalContentAlignment="Left"
                                Padding="8,4"
                                Click="StatsEscalationPickerButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Width="130" Margin="0,0,14,0">
                        <TextBlock Text="Resolved from" FontSize="11" Margin="0,0,0,2"/>
                        <DatePicker x:Name="StatsFromDatePicker" ToolTip="Resolved on/after this date -- leave blank for no lower bound (only relevant when État includes resolved issues)"/>
                    </StackPanel>

                    <StackPanel Width="130" Margin="0,0,14,0">
                        <TextBlock Text="Resolved to" FontSize="11" Margin="0,0,0,2"/>
                        <DatePicker x:Name="StatsToDatePicker" ToolTip="Resolved on/before this date (inclusive) -- leave blank for no upper bound (only relevant when État includes resolved issues)"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button
                            x:Name="RunStatsButton"
                            Content="Run stats"
                            Width="90"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RunStatsButton_Click"/>
                        <ProgressBar
                            x:Name="StatsProgressBar"
                            Width="80"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            IsIndeterminate="True"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                    <RadioButton x:Name="StatsViewListRadio" Content="List" GroupName="StatsView" Checked="StatsViewRadio_Checked" Margin="0,0,14,0"/>
                    <RadioButton x:Name="StatsViewChartRadio" Content="Chart" GroupName="StatsView" Checked="StatsViewRadio_Checked" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatsGroupByLabel" Text="Group by" FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="StatsGroupByCombo" Width="130" Visibility="Collapsed" SelectionChanged="StatsGroupByCombo_SelectionChanged">
                        <ComboBoxItem Content="Period" Tag="Period"/>
                        <ComboBoxItem Content="Person" Tag="Assignee"/>
                        <ComboBoxItem Content="État" Tag="Status"/>
                        <ComboBoxItem Content="Priority" Tag="Priority"/>
                        <ComboBoxItem Content="Project" Tag="Project"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock
                    x:Name="StatsStatusText"
                    Grid.Row="4"
                    FontSize="11"
                    Margin="0,0,0,8"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="Wrap"/>

                <Grid Grid.Row="5">
                    <DataGrid
                        x:Name="StatsGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        RowHeight="40"
                        MouseDoubleClick="StatsGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" SortMemberPath="Key" Width="Auto"/>

                            <DataGridTextColumn
                                Header="Summary"
                                Binding="{Binding Summary}"
                                SortMemberPath="Summary"
                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Priority" SortMemberPath="Priority" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{Binding Priority, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Margin="0,0,6,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Priority}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding Priority, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="État" SortMemberPath="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{Binding Status, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Margin="0,0,6,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Status}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding Status, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" SortMemberPath="Assignee" Width="*"/>

                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Content="View"
                                            Width="70"
                                            Click="OpenJiraResult_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer
                        x:Name="StatsChartScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
                        <ItemsControl x:Name="StatsChartItemsControl" Margin="4,8,4,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="80" Margin="6,0" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                        <Border
                                            Background="{StaticResource AccentBrush}"
                                            Height="{Binding BarHeight}"
                                            Width="42"
                                            HorizontalAlignment="Center"
                                            CornerRadius="3,3,0,0"
                                            Margin="0,2,0,0"/>
                                        <TextBlock
                                            Text="{Binding Label}"
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center"
                                            Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- WIKI TAB -->
        <!-- ===================================================== -->
        <ContentControl
            x:Name="WikiTabContent"
            Grid.Row="2"
            Visibility="Collapsed"/>

        <!-- ===================================================== -->
        <!-- PROJECT INFO TAB -->
        <!-- ===================================================== -->
        <ContentControl
            x:Name="ProjectInfoTabContent"
            Grid.Row="2"
            Visibility="Collapsed"/>
    </Grid>
</UserControl>
