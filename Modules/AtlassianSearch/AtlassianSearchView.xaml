<UserControl
    x:Class="KubaToolKit.Modules.AtlassianSearch.AtlassianSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.AtlassianSearch">

    <UserControl.Resources>
        <local:JiraPriorityBadgeBackgroundConverter x:Key="JiraPriorityBadgeBackgroundConverter"/>
        <local:JiraPriorityBadgeForegroundConverter x:Key="JiraPriorityBadgeForegroundConverter"/>
        <local:JiraStatusBadgeBackgroundConverter x:Key="JiraStatusBadgeBackgroundConverter"/>
        <local:JiraStatusBadgeForegroundConverter x:Key="JiraStatusBadgeForegroundConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Atlassian Search"
                FontWeight="Bold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"
                VerticalAlignment="Center"/>

            <ProgressBar
                x:Name="LoadingProgressBar"
                Grid.Column="1"
                Margin="16,0"
                Visibility="Collapsed"
                IsIndeterminate="True"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="QueryTextBox"
                Grid.Column="2"
                Width="320"
                VerticalContentAlignment="Center"
                ToolTip="Search term (e.g. an error message or a component name) -- Enter to search"
                KeyDown="QueryTextBox_KeyDown"/>

            <Button
                x:Name="SearchButton"
                Grid.Column="3"
                Width="90"
                Margin="8,0,0,0"
                Content="Search"
                Style="{StaticResource AccentButtonStyle}"
                Click="SearchButton_Click"/>

            <Button
                x:Name="RefreshButton"
                Grid.Column="4"
                Width="70"
                Margin="8,0,0,0"
                Content="Refresh"
                ToolTip="Re-run the current search/queue with the same filters"
                Click="RefreshButton_Click"/>

            <Button
                x:Name="PopoutJiraButton"
                Grid.Column="5"
                Width="80"
                Margin="8,0,0,0"
                Content="Pop out"
                ToolTip="Pop out Jira into its own auto-refreshing window"
                Click="PopoutJiraButton_Click"/>

            <Button
                x:Name="SettingsButton"
                Grid.Column="6"
                Width="90"
                Margin="8,0,0,0"
                Content="Settings"
                Click="SettingsButton_Click"/>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            FontSize="11"
            Margin="0,0,0,10"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"/>

        <!-- Results -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ConfluenceRow" Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="JiraRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Confluence -->
            <Border
                Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <Expander
                    x:Name="ConfluenceResultsExpander"
                    Header="Confluence pages"
                    IsExpanded="False"
                    Expanded="ResultsExpander_Changed"
                    Collapsed="ResultsExpander_Changed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8" VerticalAlignment="Top">

                            <StackPanel Width="140" Margin="0,0,14,0">
                                <TextBlock Text="Space" FontSize="11" Margin="0,0,0,2"/>
                                <Button
                                    x:Name="ConfluenceSpaceButton"
                                    Content="(Any)"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,4"
                                    ToolTip="Pick one or more Confluence spaces (favorites listed first, right-click to favorite)"
                                    Click="ConfluenceSpaceButton_Click"/>
                            </StackPanel>

                            <StackPanel Width="160" Margin="0,0,14,0">
                                <TextBlock Text="Group" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="ConfluenceGroupSearchBox" ToolTip="Type to search top-level pages"/>
                                <ComboBox
                                    x:Name="ConfluenceGroupCombo"
                                    Margin="0,2,0,0"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    ToolTip="Top-level page of the space"
                                    SelectionChanged="ConfluenceGroupCombo_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="160" Margin="0,0,14,0">
                                <TextBlock Text="Page" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="ConfluencePageSearchBox" ToolTip="Type to search pages"/>
                                <ComboBox
                                    x:Name="ConfluencePageCombo"
                                    Margin="0,2,0,0"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    ToolTip="Page inside the selected group"
                                    SelectionChanged="ConfluencePageCombo_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="160">
                                <TextBlock Text="Article" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="ConfluenceArticleSearchBox" ToolTip="Type to search articles"/>
                                <ComboBox
                                    x:Name="ConfluenceArticleCombo"
                                    Margin="0,2,0,0"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    ToolTip="Article inside the selected page"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid
                            x:Name="ConfluenceGrid"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="False"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            RowHeight="44"
                            MouseDoubleClick="ConfluenceGrid_MouseDoubleClick">

                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Header="Title"
                                    Binding="{Binding Title}"
                                    SortMemberPath="Title"
                                    Width="*"/>

                                <DataGridTextColumn
                                    Header="Space"
                                    Binding="{Binding Space}"
                                    SortMemberPath="Space"
                                    Width="Auto"/>

                                <DataGridTextColumn
                                    Header="Excerpt"
                                    Binding="{Binding Excerpt}"
                                    SortMemberPath="Excerpt"
                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Excerpt}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Content="View"
                                                Width="70"
                                                Click="OpenConfluenceResult_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Expander>
            </Border>

            <GridSplitter
                Grid.Row="1"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                ResizeBehavior="PreviousAndNext"/>

            <!-- Jira -->
            <Border
                Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <Expander
                    x:Name="JiraResultsExpander"
                    Header="Jira issues"
                    IsExpanded="False"
                    Expanded="ResultsExpander_Changed"
                    Collapsed="ResultsExpander_Changed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Saved list" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                x:Name="JiraSavedFilterCombo"
                                Width="200"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"
                                ToolTip="A saved combination of the filters below (e.g. 'Unassigned &gt; P2')"
                                SelectionChanged="JiraSavedFilterCombo_SelectionChanged"/>
                            <Button
                                x:Name="SaveJiraFilterButton"
                                Content="Save current..."
                                Width="110"
                                Margin="8,0,0,0"
                                Click="SaveJiraFilterButton_Click"/>
                            <Button
                                x:Name="DeleteJiraFilterButton"
                                Content="Delete"
                                Width="70"
                                Margin="8,0,0,0"
                                IsEnabled="False"
                                Click="DeleteJiraFilterButton_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">

                        <StackPanel Width="185" Margin="0,0,14,0">
                            <TextBlock Text="Project" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="JiraProjectSearchBox" ToolTip="Type to search projects, or a comma-separated list for 'in'/'not in'"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox x:Name="JiraProjectOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                    <ComboBoxItem Content="="/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="in"/>
                                    <ComboBoxItem Content="not in"/>
                                </ComboBox>
                                <ComboBox
                                    x:Name="JiraProjectCombo"
                                    Width="126"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    SelectionChanged="JiraProjectCombo_SelectionChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Width="160" Margin="0,0,14,0">
                            <TextBlock Text="Queue" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox
                                x:Name="JiraQueueSearchBox"
                                ToolTip="Type to search this project's Service Management queues"/>
                            <ComboBox
                                x:Name="JiraQueueCombo"
                                Margin="0,2,0,0"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Value"
                                ToolTip="A saved Service Management queue (e.g. 'L1 Incidents') -- Reporter/Assignee/Priority/Status below narrow its results the same way Jira's own queue view lets you filter them"/>
                        </StackPanel>

                        <StackPanel Width="185" Margin="0,0,14,0">
                            <TextBlock Text="Reporter" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox
                                x:Name="JiraReporterSearchBox"
                                ToolTip="Type to search, or a comma-separated list for 'in'/'not in' -- not every user may be listed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox x:Name="JiraReporterOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                    <ComboBoxItem Content="="/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="in"/>
                                    <ComboBoxItem Content="not in"/>
                                </ComboBox>
                                <ComboBox
                                    x:Name="JiraReporterCombo"
                                    Width="126"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Width="185" Margin="0,0,14,0">
                            <TextBlock Text="Assignee" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox
                                x:Name="JiraAssigneeSearchBox"
                                ToolTip="Type to search, or a comma-separated list for 'in'/'not in' -- not every user may be listed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox x:Name="JiraAssigneeOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                    <ComboBoxItem Content="="/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="in"/>
                                    <ComboBoxItem Content="not in"/>
                                </ComboBox>
                                <ComboBox
                                    x:Name="JiraAssigneeCombo"
                                    Width="126"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Width="185" Margin="0,0,14,0">
                            <TextBlock Text="Priority" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="JiraPrioritySearchBox" ToolTip="Type to search, or a comma-separated list for 'in'/'not in'"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox
                                    x:Name="JiraPriorityOperatorCombo"
                                    Width="55"
                                    Margin="0,0,4,0"
                                    SelectedIndex="0"
                                    ToolTip="'&gt;'/'&lt;' compare urgency using this site's own priority order">
                                    <ComboBoxItem Content="="/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="&gt;"/>
                                    <ComboBoxItem Content="&gt;="/>
                                    <ComboBoxItem Content="&lt;"/>
                                    <ComboBoxItem Content="&lt;="/>
                                    <ComboBoxItem Content="in"/>
                                    <ComboBoxItem Content="not in"/>
                                </ComboBox>
                                <ComboBox
                                    x:Name="JiraPriorityCombo"
                                    Width="126"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Width="185">
                            <TextBlock Text="Status" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="JiraStatusSearchBox" ToolTip="Type to search, or a comma-separated list for 'in'/'not in'"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ComboBox x:Name="JiraStatusOperatorCombo" Width="55" Margin="0,0,4,0" SelectedIndex="0">
                                    <ComboBoxItem Content="="/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="in"/>
                                    <ComboBoxItem Content="not in"/>
                                </ComboBox>
                                <ComboBox
                                    x:Name="JiraStatusCombo"
                                    Width="126"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"/>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>

                        <DataGrid
                            x:Name="JiraGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="False"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            RowHeight="40"
                            MouseDoubleClick="JiraGrid_MouseDoubleClick">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" SortMemberPath="Key" Width="Auto"/>

                                <DataGridTextColumn
                                    Header="Summary"
                                    Binding="{Binding Summary}"
                                    SortMemberPath="Summary"
                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Priority" SortMemberPath="Priority" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{Binding Priority, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Margin="0,0,6,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding Priority}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding Priority, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{Binding Status, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Margin="0,0,6,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding Status, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Reporter" Binding="{Binding Reporter}" SortMemberPath="Reporter" Width="*"/>
                                <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" SortMemberPath="Assignee" Width="*"/>

                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Content="Open"
                                                Width="70"
                                                Click="OpenJiraResult_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Expander>
            </Border>
        </Grid>
    </Grid>
</UserControl>
