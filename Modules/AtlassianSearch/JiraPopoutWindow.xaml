<Window
    x:Class="KubaToolKit.Modules.AtlassianSearch.JiraPopoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.AtlassianSearch"
    Title="Jira issues"
    Width="1000"
    Height="650"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:JiraPriorityBadgeBackgroundConverter x:Key="JiraPriorityBadgeBackgroundConverter"/>
        <local:JiraPriorityBadgeForegroundConverter x:Key="JiraPriorityBadgeForegroundConverter"/>
        <local:JiraStatusBadgeBackgroundConverter x:Key="JiraStatusBadgeBackgroundConverter"/>
        <local:JiraStatusBadgeForegroundConverter x:Key="JiraStatusBadgeForegroundConverter"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Saved list"
                VerticalAlignment="Center"
                Margin="0,0,8,0"/>

            <ComboBox
                x:Name="SavedFilterCombo"
                Grid.Column="1"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                SelectionChanged="SavedFilterCombo_SelectionChanged"/>

            <TextBlock
                Grid.Column="2"
                Text="Refresh every"
                VerticalAlignment="Center"
                Margin="16,0,8,0"/>

            <ComboBox
                x:Name="RefreshIntervalCombo"
                Grid.Column="3"
                SelectedIndex="0"
                SelectionChanged="RefreshIntervalCombo_SelectionChanged">
                <ComboBoxItem Content="Off" Tag="0"/>
                <ComboBoxItem Content="1 min" Tag="1"/>
                <ComboBoxItem Content="2 min" Tag="2"/>
                <ComboBoxItem Content="5 min" Tag="5"/>
                <ComboBoxItem Content="10 min" Tag="10"/>
                <ComboBoxItem Content="30 min" Tag="30"/>
            </ComboBox>

            <Button
                Grid.Column="5"
                Content="Mark all as read"
                Width="130"
                Margin="8,0,0,0"
                Click="MarkAllAsReadButton_Click"/>

            <Button
                Grid.Column="6"
                Content="🔄"
                Width="34"
                FontSize="14"
                Margin="8,0,0,0"
                ToolTip="Refresh now"
                Click="RefreshButton_Click"/>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            FontSize="11"
            Margin="0,0,0,10"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"/>

        <DataGrid
            x:Name="JiraGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserSortColumns="False"
            HeadersVisibility="Column"
            HorizontalScrollBarVisibility="Disabled"
            VirtualizingPanel.ScrollUnit="Pixel"
            RowHeight="40"
            MouseDoubleClick="JiraGrid_MouseDoubleClick">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                            <Setter Property="Background" Value="{Binding Priority, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" SortMemberPath="Key" Width="Auto"/>

                <DataGridTextColumn
                    Header="Summary"
                    Binding="{Binding Summary}"
                    SortMemberPath="Summary"
                    Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Priority" SortMemberPath="Priority" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Background="{Binding Priority, Converter={StaticResource JiraPriorityBadgeBackgroundConverter}}"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Priority}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{Binding Priority, Converter={StaticResource JiraPriorityBadgeForegroundConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Background="{Binding Status, Converter={StaticResource JiraStatusBadgeBackgroundConverter}}"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Status}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{Binding Status, Converter={StaticResource JiraStatusBadgeForegroundConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Reporter" Binding="{Binding Reporter}" SortMemberPath="Reporter" Width="*"/>
                <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee}" SortMemberPath="Assignee" Width="*"/>

                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Content="Open"
                                Width="70"
                                Click="OpenJiraResult_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
