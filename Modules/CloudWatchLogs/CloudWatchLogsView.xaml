<UserControl
    x:Class="KubaToolKit.Modules.CloudWatchLogs.CloudWatchLogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:local="clr-namespace:KubaToolKit.Modules.CloudWatchLogs"
    xmlns:behaviors="clr-namespace:KubaToolKit.Shared.Behaviors"
    xmlns:converters="clr-namespace:KubaToolKit.Shared.Converters">

    <UserControl.Resources>
        <local:LogGroupNameConverter x:Key="LogGroupNameConverter"/>
        <converters:TimestampPartConverter x:Key="TimestampPartConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>

            <!-- Debug panel (only takes space once the Debug mode toggle,
                 now up in the shared date-range row, is checked) -->
            <RowDefinition Height="Auto"/>

            <!-- Log groups -->
            <RowDefinition x:Name="LogGroupsRow"
                   Height="*"
                   MinHeight="80"/>

            <!-- Splitter -->
            <RowDefinition Height="6"/>

            <!-- Results -->
            <RowDefinition x:Name="ResultsRow"
                   Height="*"
                   MinHeight="150"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- DEBUG MODE -->
        <!-- ===================================================== -->

        <Border
           x:Name="DebugModePanel"
           Grid.Row="0"
           Visibility="Collapsed"
           Margin="0,0,0,8"
           Padding="{StaticResource CardPadding}"
           BorderBrush="{StaticResource BorderBrush}"
           BorderThickness="1"
           CornerRadius="{StaticResource RadiusMedium}"
           Background="{StaticResource SurfaceBrush}"
           Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="CloudWatch Logs Insights Query"/>
                <Border
                    Grid.Row="1"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4">
                    <avalonedit:TextEditor
                        x:Name="QueryEditorTextBox"
                        MinHeight="36"
                        FontFamily="Cascadia Code, Consolas"
                        FontSize="13"
                        ShowLineNumbers="True"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Grid
                  Grid.Row="2"
                  Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="120"
                        Content="Preview Query"
                        Click="PreviewQuery_Click"/>
                    <Button
                        Grid.Column="2"
                        Width="120"
                        Content="Copy Query"
                        Click="CopyQuery_Click"/>
                    <Button
                        Grid.Column="4"
                        Width="150"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Use Custom Query"
                        Click="UseCustomQuery_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- LOG GROUPS -->
        <!-- ===================================================== -->

        <Expander
            x:Name="LogGroupsExpander"
            Grid.Row="1"
            IsExpanded="True"
            Margin="0,0,0,8"
            Expanded="LogGroupsExpander_ExpandedCollapsed"
            Collapsed="LogGroupsExpander_ExpandedCollapsed">
            <Expander.Header>
                <TextBlock
                    Text="Log Groups"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"/>
            </Expander.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <CheckBox
                    x:Name="SearchAllLogsCheckBox"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Content="Search in all log groups"
                    FontWeight="SemiBold"
                    Checked="SearchAllLogsCheckBox_Changed"
                    Unchecked="SearchAllLogsCheckBox_Changed"/>
                <TreeView
                    x:Name="LogGroupsTreeView"
                    Grid.Row="1"
                    PreviewMouseWheel="LogGroupsTreeView_PreviewMouseWheel">

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate
        ItemsSource="{Binding Children}">

                            <StackPanel
            Orientation="Horizontal">

                                <CheckBox
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                VerticalAlignment="Center"/>

                                <TextBlock
                Text="{Binding Name}"
                Margin="6,0,0,0"
                VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Expander>
        <GridSplitter
               x:Name="LogGroupSplitter"
               Grid.Row="2"
               Height="6"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Center"
               ResizeBehavior="PreviousAndNext"
               ResizeDirection="Rows"/>

        <!-- ===================================================== -->
        <!-- RESULTS -->
        <!-- ===================================================== -->

        <Grid Grid.Row="3"
            x:Name="ResultsPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress -->
            <Grid
              Grid.Row="0"
              Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ProgressTextBlock"
                    Grid.Column="0"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}"/>
                <ProgressBar
                    x:Name="SearchProgressBar"
                    Grid.Column="1"
                    Margin="16,0,4,0"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    VerticalAlignment="Center"/>
                <Button
                    x:Name="DownloadAllLogsButton"
                    Grid.Column="2"
                    Padding="10,2"
                    IsEnabled="False"
                    Click="DownloadAllLogsButton_Click"
                    ToolTip="Download every result group below as a local .log file, all in one go">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,19 A2,2 0 0 0 6,21 L18,21 A2,2 0 0 0 20,19 L20,17"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Download all" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Results -->
            <Border
                 Grid.Row="1"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 CornerRadius="{StaticResource RadiusMedium}"
                 Background="{StaticResource SurfaceBrush}"
                 Effect="{StaticResource CardShadowEffect}"
                 Padding="{StaticResource CardPadding}">
                <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="True">
                    <ItemsControl
                       x:Name="LogsGroupedItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander
                                    IsExpanded="False"
                                    Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Padding="7,2"
                                                CornerRadius="{StaticResource RadiusMedium}"
                                                Background="{StaticResource AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AccentPressedBrush}"
                                                    Text="{Binding Count, StringFormat={}{0} logs}"/>
                                            </Border>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                Text="{Binding LogGroup, Converter={StaticResource LogGroupNameConverter}}"
                                                FontWeight="Bold"
                                                FontSize="13"
                                                Foreground="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center"/>
                                            <Button
                                                Margin="10,0,0,0"
                                                Padding="6,1"
                                                FontSize="10.5"
                                                Click="DownloadLogGroupButton_Click"
                                                Tag="{Binding}"
                                                ToolTip="Download this group's matched logs to a local file">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path
                                                        Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,19 A2,2 0 0 0 6,21 L18,21 A2,2 0 0 0 20,19 L20,17"
                                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                        Width="9" Height="9" Stretch="Uniform"
                                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Download" FontSize="10.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Expander.Header>
                                    <DataGrid
                                            ItemsSource="{Binding Logs}"
                                            AutoGenerateColumns="False"
                                            IsReadOnly="True"
                                            HeadersVisibility="Column"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            Margin="0,6,0,0"
                                            MaxHeight="350"
                                            RowHeight="48"
                                            MouseDoubleClick="LogsDataGrid_DoubleClick"
                                            HorizontalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn
                                                    Header="Timestamp"
                                                    Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{Binding Timestamp, Converter={StaticResource TimestampPartConverter}, ConverterParameter=date}"
                                                                FontSize="10.5"
                                                                Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock
                                                                Text="{Binding Timestamp, Converter={StaticResource TimestampPartConverter}}"
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn
                                                    Header="Message"
                                                    Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,5"
                                                            Margin="0,4"
                                                            MaxHeight="42">
                                                            <TextBlock
                                                                behaviors:JsonHighlightBehavior.Text="{Binding Message}"
                                                                FontFamily="Cascadia Code, Consolas"
                                                                FontSize="12"
                                                                TextWrapping="Wrap"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
