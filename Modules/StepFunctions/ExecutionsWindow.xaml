<Window
    x:Class="KubaToolKit.Modules.StepFunctions.ExecutionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:KubaToolKit.Shared.Converters"
    Title="Executions"
    Width="1000"
    Height="650"
    MinWidth="700"
    MinHeight="400"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:TimestampPartConverter x:Key="TimestampPartConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border
                        Width="34" Height="34" Margin="0,0,12,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource AccentGradientBrush}">
                        <Path
                            Data="M5,3.2 A1.8,1.8 0 1 0 5,6.8 A1.8,1.8 0 1 0 5,3.2 Z M19,3.2 A1.8,1.8 0 1 0 19,6.8 A1.8,1.8 0 1 0 19,3.2 Z M12,16.2 A1.8,1.8 0 1 0 12,19.8 A1.8,1.8 0 1 0 12,16.2 Z M5,6.8 L5,12 L19,12 L19,6.8 M12,12 L12,16.2"
                            Stroke="{StaticResource TextOnAccentBrush}"
                            StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="18" Height="18" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="StateMachineNameTextBlock"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock
                            x:Name="ExpressHintTextBlock"
                            Text="EXPRESS"
                            FontSize="11"
                            FontStyle="Italic"
                            Foreground="{StaticResource TextMutedBrush}"
                            Margin="0,2,0,0"
                            Visibility="Collapsed"
                            ToolTip="List rebuilt from CloudWatch Logs (last 7 days, requires logging to be enabled)."/>
                    </StackPanel>
                </StackPanel>

                <ProgressBar
                    x:Name="LoadingProgressBar"
                    Grid.Column="1"
                    Margin="20,0"
                    Visibility="Collapsed"
                    IsIndeterminate="True"
                    VerticalAlignment="Center"/>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Data="M20,11 A8,8 0 1 0 18.5,15.5 M20,5 L20,11 L14,11"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Executions -->
        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <DataGrid
                x:Name="ExecutionsGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="False"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VirtualizingPanel.ScrollUnit="Pixel"
                RowHeight="48"
                MouseDoubleClick="ExecutionsGrid_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Header="Execution"
                        Binding="{Binding Name}"
                        SortMemberPath="Name"
                        Width="*"/>

                    <DataGridTemplateColumn
                        Header="Status"
                        SortMemberPath="Status"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,3"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}"/>
                                        <TextBlock
                                            Text="{Binding Status}"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            Foreground="{Binding StatusAccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Header="Start"
                        SortMemberPath="StartDate"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding StartDisplay, Converter={StaticResource TimestampPartConverter}, ConverterParameter=date}"
                                        FontSize="10.5"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock
                                        Text="{Binding StartDisplay, Converter={StaticResource TimestampPartConverter}}"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Header="Stop"
                        SortMemberPath="StopDate"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding StopDisplay, Converter={StaticResource TimestampPartConverter}, ConverterParameter=date}"
                                        FontSize="10.5"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock
                                        Text="{Binding StopDisplay, Converter={StaticResource TimestampPartConverter}}"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
