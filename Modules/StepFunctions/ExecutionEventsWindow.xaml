<Window
    x:Class="KubaToolKit.Modules.StepFunctions.ExecutionEventsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:KubaToolKit.Shared.Converters"
    Title="Execution Events"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="400"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:TimestampPartConverter x:Key="TimestampPartConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border
                        Width="34" Height="34" Margin="0,0,12,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource AccentGradientBrush}">
                        <Path
                            Data="M5,3.2 A1.8,1.8 0 1 0 5,6.8 A1.8,1.8 0 1 0 5,3.2 Z M19,3.2 A1.8,1.8 0 1 0 19,6.8 A1.8,1.8 0 1 0 19,3.2 Z M12,16.2 A1.8,1.8 0 1 0 12,19.8 A1.8,1.8 0 1 0 12,16.2 Z M5,6.8 L5,12 L19,12 L19,6.8 M12,12 L12,16.2"
                            Stroke="{StaticResource TextOnAccentBrush}"
                            StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="18" Height="18" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock
                        x:Name="ExecutionNameTextBlock"
                        FontWeight="Bold"
                        FontSize="15"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <ProgressBar
                    x:Name="LoadingProgressBar"
                    Grid.Column="1"
                    Margin="20,0"
                    Visibility="Collapsed"
                    IsIndeterminate="True"
                    VerticalAlignment="Center"/>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Data="M20,11 A8,8 0 1 0 18.5,15.5 M20,5 L20,11 L14,11"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Events -->
        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <DataGrid
                x:Name="EventsGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="False"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VirtualizingPanel.ScrollUnit="Pixel"
                RowHeight="44"
                MouseDoubleClick="EventsGrid_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Header="Timestamp"
                        SortMemberPath="Timestamp"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding TimestampDisplay, Converter={StaticResource TimestampPartConverter}, ConverterParameter=date}"
                                        FontSize="10.5"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock
                                        Text="{Binding TimestampDisplay, Converter={StaticResource TimestampPartConverter}}"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding Id}"
                        SortMemberPath="Id"
                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn
                        Header="Type"
                        SortMemberPath="Type"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,2"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Type}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Header="Step"
                        Binding="{Binding Step}"
                        SortMemberPath="Step"
                        Width="Auto"/>

                    <DataGridTextColumn
                        Header="Resource"
                        Binding="{Binding Resource}"
                        SortMemberPath="Resource"
                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
