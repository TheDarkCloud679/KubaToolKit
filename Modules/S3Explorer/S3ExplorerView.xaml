<UserControl
    x:Class="KubaToolKit.Modules.S3Explorer.S3ExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:KubaToolKit.Shared.Converters">

    <UserControl.Resources>
        <converters:DateTimePartConverter x:Key="DateTimePartConverter"/>

        <!-- Folder icons: closed (amber, filled) / open (accent, filled),
             swapped via a DataTrigger on the node's own IsExpanded so the
             DataTemplate can bind directly instead of walking up to the
             TreeViewItem. -->
        <Geometry x:Key="FolderClosedGeometry">M3,6 L9,6 L11,8 L21,8 L21,18 L3,18 Z</Geometry>
        <Geometry x:Key="FolderOpenGeometry">M4,7 L4,17 Q4,19 6,19.5 L12,21 L18,19.5 Q20,19 20,17 L20,7 Q20,5 18,4.5 L12,3 L6,4.5 Q4,5 4,7 Z</Geometry>

        <Style x:Key="S3FolderIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource FolderClosedGeometry}"/>
            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Data" Value="{StaticResource FolderOpenGeometry}"/>
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- File icons in the results grid: plain sheet (generic), sheet
             with text lines (doc-ish extensions), sheet with zipper marks
             (archives), picked from S3ObjectItem.IconKind. -->
        <Geometry x:Key="FileGenericGeometry">M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7</Geometry>
        <Geometry x:Key="FileDocGeometry">M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7 M8,12 L16,12 M8,15 L16,15 M8,18 L13,18</Geometry>
        <Geometry x:Key="FileArchiveGeometry">M6,3 L18,3 L18,21 L6,21 Z M11,3 L11,5 M13,6 L11,6 M11,7 L13,7 M13,8 L11,8 M11,9 L13,9 M13,10 L11,11 L13,11</Geometry>

        <Style x:Key="S3FileIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource FileGenericGeometry}"/>
            <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKind}" Value="Doc">
                    <Setter Property="Data" Value="{StaticResource FileDocGeometry}"/>
                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="Archive">
                    <Setter Property="Data" Value="{StaticResource FileArchiveGeometry}"/>
                    <Setter Property="Stroke" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="S3ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <CornerRadius x:Key="RadiusMediumTop">8,8,0,0</CornerRadius>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- BUCKET + BREADCRUMB + SEARCH SCOPE -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="0"
            Padding="{StaticResource CardPadding}"
            Margin="0,0,0,10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30" Height="30" Margin="0,0,10,0"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource AccentGradientBrush}">
                    <Path
                        Data="M4,7 L4,17 Q4,19 6,19.5 L12,21 L18,19.5 Q20,19 20,17 L20,7 M4,7 Q4,5 6,4.5 L12,3 L18,4.5 Q20,5 20,7 M4,7 Q4,9 6,9.5 L12,11 L18,9.5 Q20,9 20,7"
                        Stroke="{StaticResource TextOnAccentBrush}"
                        StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="15" Height="15" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Text="Bucket"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>

                <ComboBox
                    x:Name="BucketCombo"
                    Grid.Column="2"
                    Width="320"
                    VerticalAlignment="Center"
                    SelectionChanged="BucketCombo_SelectionChanged"/>

                <ScrollViewer
                    Grid.Column="3"
                    Margin="16,0,0,0"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalAlignment="Center">
                    <ItemsControl
                        x:Name="BreadcrumbItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Border
                    x:Name="SearchScopeChip"
                    Grid.Column="4"
                    Margin="16,0,0,0"
                    Padding="8,4"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource AccentSoftBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16,16 L21,21"
                            Stroke="{StaticResource AccentPressedBrush}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                            Width="11" Height="11" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock
                            x:Name="SearchScopeText"
                            FontSize="11" FontWeight="SemiBold"
                            Foreground="{StaticResource AccentPressedBrush}"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="✕"
                            Margin="8,0,0,0"
                            FontSize="10"
                            Foreground="{StaticResource AccentPressedBrush}"
                            Opacity="0.7"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="S3ClearSearchScope_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- PROGRESS / QUEUE -->
        <!-- ===================================================== -->

        <Border
            x:Name="S3ProgressCard"
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="14,10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="S3QueueText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"/>

                <ProgressBar
                    x:Name="SearchProgressBar"
                    Grid.Column="1"
                    Margin="14,0"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    Value="0"/>

                <TextBlock
                    x:Name="S3LoadingText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="0%"/>

                <Button
                    x:Name="CancelDownloadButton"
                    Grid.Column="3"
                    Margin="14,0,0,0"
                    Width="80"
                    Height="26"
                    Content="Cancel"
                    Click="CancelDownloadButton_Click"/>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- TREE + FILES -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">
                <TreeView
                    x:Name="S3TreeView"
                    SelectedItemChanged="S3TreeView_SelectedItemChanged">
                    <TreeView.Resources>
                        <ContextMenu x:Key="S3FolderMenu">
                            <MenuItem
                                Header="Search from here"
                                Click="S3SearchFromHere_Click"/>
                            <MenuItem
                                Header="Clear search scope"
                                Click="S3ClearSearchScope_Click"/>
                        </ContextMenu>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <EventSetter
                                Event="Expanded"
                                Handler="S3TreeViewItem_Expanded"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate
                            ItemsSource="{Binding Children}">
                            <Border
                                Padding="6,3"
                                Margin="0,1,0,1"
                                CornerRadius="4"
                                ContextMenu="{StaticResource S3FolderMenu}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSearchRoot}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource S3FolderIconStyle}"/>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"/>

            <Border
                Grid.Column="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border
                        Grid.Row="0"
                        Padding="10,8"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource RadiusMediumTop}">
                        <DockPanel LastChildFill="False">
                            <TextBlock
                                x:Name="S3SelectionCountText"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}"/>

                            <Button
                                x:Name="S3RefreshButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource S3ToolbarButtonStyle}"
                                Margin="0"
                                Click="S3Refresh_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M20,11 A8,8 0 1 0 18.5,15.5 M20,5 L20,11 L14,11"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        Width="12" Height="12" Stretch="Uniform"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="S3DeleteButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource S3ToolbarButtonStyle}"
                                Foreground="{StaticResource DangerBrush}"
                                Click="S3DeleteFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 A1,1 0 0 0 8,21 L16,21 A1,1 0 0 0 17,20 L18,7"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        Width="12" Height="12" Stretch="Uniform"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="S3RenameButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource S3ToolbarButtonStyle}"
                                Click="S3RenameFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M4,20 L4,16 L15,5 A2,2 0 0 1 18,5 L19,6 A2,2 0 0 1 19,9 L8,20 Z"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        Width="12" Height="12" Stretch="Uniform"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Rename" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="S3DownloadButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource S3ToolbarButtonStyle}"
                                Click="S3DownloadFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,17 L4,19 A2,2 0 0 0 6,21 L18,21 A2,2 0 0 0 20,19 L20,17"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        Width="12" Height="12" Stretch="Uniform"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Download" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="{StaticResource CardPadding}">

                        <DataGrid
                            x:Name="S3FilesGrid"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow"
                            AllowDrop="True"
                            RowHeight="48"
                            SelectionChanged="S3FilesGrid_SelectionChanged"
                            Drop="S3FilesGrid_Drop"
                            DragOver="S3FilesGrid_DragOver"
                            DragLeave="S3FilesGrid_DragLeave"
                            MouseDoubleClick="S3FilesGrid_DoubleClick">

                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="S3OpenFile_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Download" Click="S3DownloadFile_Click"/>
                                    <MenuItem Header="Rename" Click="S3RenameFile_Click"/>
                                    <MenuItem Header="Delete" Click="S3DeleteFile_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Header="Name"
                                    SortMemberPath="Name"
                                    Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource S3FileIconStyle}"/>
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn
                                    Header="Size"
                                    SortMemberPath="Size"
                                    Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="8,2"
                                                CornerRadius="{StaticResource RadiusMedium}"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding SizeDisplay}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn
                                    Header="Last Modified"
                                    SortMemberPath="LastModified"
                                    Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding LastModified, Converter={StaticResource DateTimePartConverter}, ConverterParameter=date}"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock
                                                    Text="{Binding LastModified, Converter={StaticResource DateTimePartConverter}}"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                        </DataGrid>

                        <Border
                            x:Name="S3DropOverlay"
                            Visibility="Collapsed"
                            Margin="8"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusLarge}"
                            IsHitTestVisible="False">

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Border
                                    Width="52" Height="52"
                                    Margin="0,0,0,10"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Background="{StaticResource SurfaceBrush}"
                                    Effect="{StaticResource CardShadowEffect}"
                                    HorizontalAlignment="Center">
                                    <Path
                                        Data="M12,16 L12,4 M7,9 L12,4 L17,9 M4,17 L4,19 A2,2 0 0 0 6,21 L18,21 A2,2 0 0 0 20,19 L20,17"
                                        Stroke="{StaticResource AccentBrush}"
                                        StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        Width="24" Height="24" Stretch="Uniform"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock
                                    Text="Drop to upload file(s)"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    x:Name="S3DropDestinationText"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
