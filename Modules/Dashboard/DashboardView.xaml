<UserControl
    x:Class="KubaToolKit.Modules.Dashboard.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.Dashboard">

    <UserControl.Resources>
        <local:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Dashboard"
                FontWeight="Bold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"
                VerticalAlignment="Center"/>

            <ProgressBar
                x:Name="LoadingProgressBar"
                Grid.Column="1"
                Margin="16,0"
                Visibility="Collapsed"
                IsIndeterminate="True"
                VerticalAlignment="Center"/>

            <Button
                x:Name="ProjectInfoButton"
                Grid.Column="2"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,10,0"
                Click="ProjectInfoButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse
                            Width="12" Height="12" Margin="1"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.3"/>
                        <Line
                            X1="7" Y1="6.3" X2="7" Y2="10.3"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse
                            Width="1.6" Height="1.6" Margin="6.2,3.6,0,0"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                    <TextBlock Text="Project Info" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="WikiButton"
                Grid.Column="3"
                Width="32"
                Style="{StaticResource SecondaryButtonStyle}"
                Padding="0"
                Margin="0,0,10,0"
                ToolTip="Wiki"
                Click="WikiButton_Click">
                <Grid Width="14" Height="14">
                    <Ellipse
                        Width="12" Height="12" Margin="1"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.3"/>
                    <Ellipse
                        Width="5" Height="12" Margin="4.5,1,4.5,1"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.1"/>
                    <Line
                        X1="1.3" Y1="7" X2="12.7" Y2="7"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.1"/>
                </Grid>
            </Button>

            <Button
                x:Name="RefreshButton"
                Grid.Column="4"
                Style="{StaticResource AccentButtonStyle}"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Data="M13.125,7.5 A5.625,5.625 0 1 1 11.475,3.525 M13.125,1.875 L13.125,5.625 L9.375,5.625"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="15" Height="15" Stretch="Uniform"
                        VerticalAlignment="Center" Margin="0,0,7,0"
                        RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RefreshIconRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Metric sections -->
        <Grid Grid.Row="1">
            <Grid.Resources>
                <Style x:Key="MetricCellStyle" TargetType="Border">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition x:Name="RdsRow" Height="280"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="Ec2Row" Height="*"/>
            </Grid.RowDefinitions>

            <!-- RDS -->
            <Expander
                x:Name="RdsExpander"
                Grid.Row="0"
                IsExpanded="True"
                Expanded="RdsExpander_ExpandedCollapsed"
                Collapsed="RdsExpander_ExpandedCollapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Text="RDS Instances"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Expander.Header>

                <Border
                    MinHeight="120"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource SurfaceBrush}"
                    Effect="{StaticResource CardShadowEffect}"
                    Padding="{StaticResource CardPadding}">

                    <DataGrid
                        x:Name="RdsGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        RowHeight="40"
                        MouseDoubleClick="RdsGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="DB Instance"
                                Binding="{Binding Identifier}"
                                SortMemberPath="Identifier"
                                Width="Auto"/>

                            <DataGridTextColumn
                                Header="Engine"
                                Binding="{Binding Engine}"
                                SortMemberPath="Engine"
                                Width="Auto"/>

                            <DataGridTemplateColumn
                                Header="Status"
                                SortMemberPath="Status"
                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8,3"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            HorizontalAlignment="Left"
                                            Background="{Binding StatusBackground}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}"/>
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontWeight="Bold"
                                                    FontSize="11"
                                                    Foreground="{Binding StatusAccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="CPU"
                                SortMemberPath="CpuPercent"
                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetricCellStyle}" MouseLeftButtonDown="CpuMetric_MouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="60" Height="6" CornerRadius="2" Background="{StaticResource BorderStrongBrush}">
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="2"
                                                        Background="{Binding CpuAccentBrush}"
                                                        Width="{Binding CpuBarPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=60}"/>
                                                </Border>
                                                <TextBlock
                                                    Text="{Binding CpuDisplay}"
                                                    FontWeight="Bold"
                                                    FontSize="11"
                                                    Margin="8,0,0,0"
                                                    Foreground="{Binding CpuAccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Activity"
                                SortMemberPath="DatabaseConnections"
                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetricCellStyle}" MouseLeftButtonDown="ActivityMetric_MouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="60" Height="6" CornerRadius="2" Background="{StaticResource BorderStrongBrush}">
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="2"
                                                        Background="{Binding ActivityAccentBrush}"
                                                        Width="{Binding ActivityBarPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=60}"/>
                                                </Border>
                                                <TextBlock
                                                    Text="{Binding ActivityDisplay}"
                                                    FontWeight="Bold"
                                                    FontSize="11"
                                                    Margin="8,0,0,0"
                                                    Foreground="{Binding ActivityAccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Auto-Start"
                                Binding="{Binding AutoStart}"
                                SortMemberPath="AutoStart"
                                Width="Auto"/>

                            <DataGridTextColumn
                                Header="Auto-Stop"
                                Binding="{Binding AutoStop}"
                                SortMemberPath="AutoStop"
                                Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Expander>

            <GridSplitter
                x:Name="RdsEc2Splitter"
                Grid.Row="1"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Rows"/>

            <!-- EC2 -->
            <Expander
                x:Name="Ec2Expander"
                Grid.Row="2"
                IsExpanded="True"
                Expanded="Ec2Expander_ExpandedCollapsed"
                Collapsed="Ec2Expander_ExpandedCollapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Text="EC2 Instances"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Expander.Header>

                <Border
                    MinHeight="120"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource SurfaceBrush}"
                    Effect="{StaticResource CardShadowEffect}"
                    Padding="{StaticResource CardPadding}">

                    <DataGrid
                        x:Name="Ec2Grid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="False"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        RowHeight="40"
                        MouseDoubleClick="Ec2Grid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Name"
                                Binding="{Binding Name}"
                                SortMemberPath="Name"
                                Width="Auto"/>

                            <DataGridTextColumn
                                Header="Type"
                                Binding="{Binding InstanceType}"
                                SortMemberPath="InstanceType"
                                Width="Auto"/>

                            <DataGridTemplateColumn
                                Header="State"
                                SortMemberPath="State"
                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8,3"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            HorizontalAlignment="Left"
                                            Background="{Binding StateBackground}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StateAccentBrush}"/>
                                                <TextBlock
                                                    Text="{Binding State}"
                                                    FontWeight="Bold"
                                                    FontSize="11"
                                                    Foreground="{Binding StateAccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Disk"
                                SortMemberPath="DiskPercent"
                                Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            ToolTip="Worst mount point found for this instance">
                                            <Border Width="60" Height="6" CornerRadius="2" Background="{StaticResource BorderStrongBrush}">
                                                <Border
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="2"
                                                    Background="{Binding DiskAccentBrush}"
                                                    Width="{Binding DiskBarPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=60}"/>
                                            </Border>
                                            <TextBlock
                                                Text="{Binding DiskDisplay}"
                                                FontWeight="Bold"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                Foreground="{Binding DiskAccentBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Auto-Start"
                                Binding="{Binding AutoStart}"
                                SortMemberPath="AutoStart"
                                Width="Auto"/>

                            <DataGridTextColumn
                                Header="Auto-Stop"
                                Binding="{Binding AutoStop}"
                                SortMemberPath="AutoStop"
                                Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
