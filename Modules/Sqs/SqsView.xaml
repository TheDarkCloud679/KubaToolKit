<UserControl
    x:Class="KubaToolKit.Modules.Sqs.SqsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border
                        Width="30" Height="30" Margin="0,0,10,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource AccentGradientBrush}">
                        <Path
                            Data="M4,7 L20,7 L20,17 L4,17 Z M4,7 L12,13 L20,7"
                            Stroke="{StaticResource TextOnAccentBrush}"
                            StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="15" Height="15" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="SQS Queues"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock
                            Text="Read only"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ProgressBar
                    x:Name="LoadingProgressBar"
                    Grid.Column="1"
                    Margin="20,0"
                    Visibility="Collapsed"
                    IsIndeterminate="True"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Margin="0,0,14,0">
                    <TextBlock
                        Text="Auto-refresh"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                    <ComboBox
                        x:Name="AutoRefreshCombo"
                        Width="80"
                        SelectedIndex="0"
                        SelectionChanged="AutoRefreshCombo_SelectionChanged">
                        <ComboBoxItem Content="Off" Tag="0"/>
                        <ComboBoxItem Content="5 s" Tag="5"/>
                        <ComboBoxItem Content="10 s" Tag="10"/>
                        <ComboBoxItem Content="30 s" Tag="30"/>
                        <ComboBoxItem Content="1 min" Tag="60"/>
                    </ComboBox>
                </StackPanel>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="3"
                    Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Data="M20,11 A8,8 0 1 0 18.5,15.5 M20,5 L20,11 L14,11"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Queues -->
        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <DataGrid
                x:Name="QueuesGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                RowHeight="48">

                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Header="Queue Name"
                        SortMemberPath="Name"
                        Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path
                                        Data="M4,7 L20,7 L20,17 L4,17 Z M4,7 L12,13 L20,7"
                                        Stroke="{StaticResource TextMutedBrush}"
                                        StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        Width="14" Height="14" Stretch="Uniform"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Header="Available"
                        SortMemberPath="AvailableMessages"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,2"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding AvailableMessages}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Header="In Flight"
                        SortMemberPath="InFlightMessages"
                        Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,2"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding InFlightMessages}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Header=""
                        Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="140"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="SearchMessage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16,16 L21,21"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                            Width="12" Height="12" Stretch="Uniform"
                                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Search Message" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
