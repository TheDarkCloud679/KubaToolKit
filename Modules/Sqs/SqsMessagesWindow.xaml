<Window
    x:Class="KubaToolKit.Modules.Sqs.SqsMessagesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:KubaToolKit.Shared.Behaviors"
    xmlns:converters="clr-namespace:KubaToolKit.Shared.Converters"
    Title="SQS Messages"
    Width="1100"
    Height="700"
    MinWidth="700"
    MinHeight="400"
    Background="{StaticResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:TimestampPartConverter x:Key="TimestampPartConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <StackPanel Orientation="Horizontal">
                <Border
                    Width="34" Height="34" Margin="0,0,12,0"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource AccentGradientBrush}">
                    <Path
                        Data="M4,7 L20,7 L20,17 L4,17 Z M4,7 L12,13 L20,7"
                        Stroke="{StaticResource TextOnAccentBrush}"
                        StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="17" Height="17" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="QueueNameTextBlock"
                        FontWeight="Bold"
                        FontSize="15"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock
                        Text="Read only"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,2,0,0"
                        ToolTip="Messages are never deleted from the queue."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search bar -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="{StaticResource CardPadding}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path
                        Grid.Column="0"
                        Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16,16 L21,21"
                        Stroke="{StaticResource TextMutedBrush}"
                        StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        Width="14" Height="14" Stretch="Uniform"
                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        KeyDown="SearchTextBox_KeyDown"/>
                </Grid>

                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Width="150"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Search Message"
                    Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusTextBlock"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}"/>

                <ProgressBar
                    x:Name="SearchProgressBar"
                    Grid.Column="1"
                    Margin="16,0,4,0"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"/>
            </Grid>

            <Border
                Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <DataGrid
                    x:Name="MessagesGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Auto"
                    RowHeight="48"
                    MouseDoubleClick="MessagesGrid_DoubleClick">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Header="Sent"
                            SortMemberPath="SentTimestamp"
                            Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding SentTimestamp, Converter={StaticResource TimestampPartConverter}, ConverterParameter=date}"
                                            FontSize="10.5"
                                            Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock
                                            Text="{Binding SentTimestamp, Converter={StaticResource TimestampPartConverter}}"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Header="Message ID"
                            SortMemberPath="MessageId"
                            Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8,2"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding MessageId}"
                                            FontFamily="Cascadia Code, Consolas"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Header="Body"
                            Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,4"
                                        MaxHeight="42">
                                        <TextBlock
                                            behaviors:JsonHighlightBehavior.Text="{Binding BodyPreview}"
                                            FontFamily="Cascadia Code, Consolas"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
