<Window
    x:Class="KubaToolKit.Modules.ApiClient.AwsApiSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sync environment from AWS"
    Width="980"
    Height="620"
    MinWidth="760"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Sync environment from AWS"
            FontWeight="Bold"
            FontSize="15"
            Foreground="{StaticResource TextPrimaryBrush}"
            Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="AWS profile"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextSecondaryBrush}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"/>

            <ComboBox
                x:Name="ProfileCombo"
                Grid.Column="1"
                VerticalContentAlignment="Center"/>

            <Button
                x:Name="DiscoverButton"
                Grid.Column="2"
                Margin="10,0,0,0"
                Padding="14,0"
                Height="28"
                Style="{StaticResource AccentButtonStyle}"
                Content="Discover"
                Click="DiscoverButton_Click"/>

            <CheckBox
                x:Name="ShowOnlyMissingCheckBox"
                Grid.Column="3"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="Show only missing"
                ToolTip="Hide endpoints whose URL is already set on some variable in this environment"
                Checked="ShowOnlyMissingCheckBox_Changed"
                Unchecked="ShowOnlyMissingCheckBox_Changed"/>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="4"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                FontSize="12.5"
                Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>

        <TextBlock
            x:Name="MissingVariablesText"
            Grid.Row="2"
            Margin="0,0,0,10"
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{StaticResource WarningPressedBrush}"
            Visibility="Collapsed"/>

        <Border
            Grid.Row="3"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="10">

            <DataGrid
                x:Name="ResultsGrid"
                AlternationCount="2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="False"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                RowHeight="44">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="API (stage)" Width="2.2*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock
                                        Text="{Binding ApiName}"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ApiName}"/>
                                    <TextBlock
                                        Text="{Binding Stage, StringFormat='stage: {0}'}"
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Header="Domain &#8594; URL"
                        Binding="{Binding Url}"
                        IsReadOnly="True"
                        Width="2.6*"
                        MinWidth="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Url}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Maps to variable" Width="1.8*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    IsEditable="True"
                                    Loaded="MapsToCombo_Loaded"
                                    Text="{Binding MapsTo, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding StatusText}"
                        IsReadOnly="True"
                        Width="1*"
                        MinWidth="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0">

            <Button
                Width="100"
                Margin="0,0,8,0"
                Content="Cancel"
                Click="CancelButton_Click"/>

            <Button
                Width="140"
                Style="{StaticResource AccentButtonStyle}"
                Content="Apply mappings"
                Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
