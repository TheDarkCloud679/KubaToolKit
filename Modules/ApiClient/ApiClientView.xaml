<UserControl
    x:Class="KubaToolKit.Modules.ApiClient.ApiClientView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="clr-namespace:KubaToolKit.Shared.Behaviors"
    xmlns:local="clr-namespace:KubaToolKit.Modules.ApiClient">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:HttpMethodBadgeBackgroundConverter x:Key="HttpMethodBadgeBackgroundConverter"/>
        <local:HttpMethodBadgeForegroundConverter x:Key="HttpMethodBadgeForegroundConverter"/>

        <!-- Row-hover-reveal icon buttons in the collections tree (Rename,
             more actions), borderless so they sit quietly next to the
             row text until hovered. -->
        <Style x:Key="TreeRowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconChevronButtonStyle}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- Body-mode chip: a friendly label on top, the real HTTP/technical
             term underneath in smaller muted text, so the raw jargon
             (form-data, x-www-form-urlencoded...) stays visible for anyone
             who already knows it without being the only thing a newcomer
             sees. Kept local to this view since the two-line content shape
             is specific to this one usage. -->
        <Style x:Key="BodyModeChipStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="12,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    x:Name="FriendlyText"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{TemplateBinding Tag}"/>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    TextElement.FontSize="{TemplateBinding FontSize}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="FriendlyText" Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Collections -->
        <Border
            Grid.Column="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPaddingCompact}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Collections"
                        FontWeight="Bold"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Double-click: sort by name"
                        MouseLeftButtonDown="CollectionsHeader_MouseLeftButtonDown"/>

                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Margin="4,0,0,0"
                        ToolTip="New collection"
                        Click="NewCollection_Click">
                        <Path
                            Data="M12,5 L12,19 M5,12 L19,12"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Margin="4,0,0,0"
                        ToolTip="Open the collections/environments folder"
                        Click="OpenCollectionsFolder_Click">
                        <Path
                            Data="M3,6 L9,6 L11,8 L21,8 L21,18 L3,18 Z"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <Button
                        Grid.Column="3"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Margin="4,0,0,0"
                        ToolTip="Reload from disk"
                        Click="ReloadCollections_Click">
                        <Path
                            Data="M20,11 A8,8 0 1 0 18.5,15.5 M20,5 L20,11 L14,11"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.ColumnSpan="3"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Background="{StaticResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path
                                Grid.Column="0"
                                Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16,16 L21,21"
                                Stroke="{StaticResource TextMutedBrush}"
                                StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                Width="11" Height="11" Stretch="Uniform"
                                VerticalAlignment="Center" Margin="7,0,0,0"/>

                            <TextBox
                                x:Name="RequestSearchBox"
                                Grid.Column="1"
                                Height="24"
                                FontSize="11"
                                Padding="6,0"
                                BorderThickness="0"
                                VerticalContentAlignment="Center"
                                ToolTip="Search for a request by name (Enter: next, Shift+Enter: previous, Esc: clear)"
                                TextChanged="RequestSearchBox_TextChanged"
                                PreviewKeyDown="RequestSearchBox_PreviewKeyDown"/>

                            <TextBlock
                                x:Name="RequestSearchCountText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <TreeView
                    x:Name="CollectionsTreeView"
                    Grid.Row="2"
                    BorderThickness="0"
                    Background="Transparent"
                    MouseDoubleClick="CollectionsTreeView_MouseDoubleClick"
                    PreviewMouseRightButtonDown="CollectionsTreeView_PreviewMouseRightButtonDown">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border
                                Padding="2,3"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path
                                            Data="M12,2 L14.5,8.5 L21,9 L16,13.5 L17.5,20 L12,16.5 L6.5,20 L8,13.5 L3,9 L9.5,8.5 Z"
                                            Fill="{StaticResource WarningBrush}"
                                            Width="11" Height="11" Stretch="Uniform"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <Border
                                            Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{Binding Method, Converter={StaticResource HttpMethodBadgeBackgroundConverter}}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Method}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{Binding Method, Converter={StaticResource HttpMethodBadgeForegroundConverter}}"/>
                                        </Border>

                                        <TextBlock
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button
                                            Style="{StaticResource TreeRowActionButtonStyle}"
                                            ToolTip="Rename"
                                            Click="TreeRowRename_Click">
                                            <Path
                                                Data="M4,20 L4,16 L15,5 A2,2 0 0 1 18,5 L19,6 A2,2 0 0 1 19,9 L8,20 Z"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                        <Button
                                            Style="{StaticResource TreeRowActionButtonStyle}"
                                            ToolTip="More actions"
                                            Click="TreeRowMoreActions_Click">
                                            <Path
                                                Data="M5,12 A1.4,1.4 0 1 0 5,12.01 M12,12 A1.4,1.4 0 1 0 12,12.01 M19,12 A1.4,1.4 0 1 0 19,12.01"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu Opened="CollectionsContextMenu_Opened">
                            <MenuItem
                                x:Name="AddRequestMenuItem"
                                Header="New request (from editor)"
                                Click="AddRequestToCollection_Click"/>
                            <MenuItem
                                x:Name="AddFolderMenuItem"
                                Header="New folder"
                                Click="AddFolder_Click"/>
                            <Separator/>
                            <MenuItem
                                x:Name="UpdateRequestMenuItem"
                                Header="Update from editor"
                                Click="UpdateRequestFromEditor_Click"/>
                            <MenuItem
                                x:Name="FavoriteMenuItem"
                                Header="☆ Add to favorites"
                                Click="ToggleFavorite_Click"/>
                            <MenuItem
                                x:Name="RenameMenuItem"
                                Header="Rename"
                                Click="RenameNode_Click"/>
                            <MenuItem
                                x:Name="FolderAuthMenuItem"
                                Header="Edit authentication"
                                Click="EditFolderAuth_Click"/>
                            <MenuItem
                                x:Name="ApplyBearerToAllMenuItem"
                                Header="Apply Bearer Token to all requests"
                                Click="ApplyBearerTokenToAllRequests_Click"/>
                            <Separator/>
                            <MenuItem
                                x:Name="DeleteMenuItem"
                                Header="Delete"
                                Click="DeleteNode_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,8,0,0">
                    <Path
                        Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M12,16 L12,11 M12,8 L12,8.2"
                        Stroke="{StaticResource TextMutedBrush}"
                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                        Width="11" Height="11" Stretch="Uniform"
                        VerticalAlignment="Top" Margin="0,1,6,0"/>
                    <TextBlock
                        Text="Right-click an item for more actions (rename, duplicate, authentication, favorites...)."
                        FontSize="10.5"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ToolTip="Drag to resize"/>

        <!-- Request / Response -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="RequestConfigRow" Height="300" MinHeight="60"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="ResponseRow" Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- Method / URL / Environment / Send -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="{StaticResource CardPadding}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="MethodCombo"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            SelectedIndex="0"
                            SelectionChanged="MethodCombo_SelectionChanged">
                            <ComboBoxItem Content="GET"/>
                            <ComboBoxItem Content="POST"/>
                            <ComboBoxItem Content="PUT"/>
                            <ComboBoxItem Content="PATCH"/>
                            <ComboBoxItem Content="DELETE"/>
                            <ComboBoxItem Content="HEAD"/>
                            <ComboBoxItem Content="OPTIONS"/>
                        </ComboBox>

                        <TextBox
                            x:Name="UrlTextBox"
                            Grid.Column="1"
                            VerticalContentAlignment="Center"
                            FontFamily="Cascadia Code, Consolas"
                            FontSize="12.5"
                            Text="https://"
                            KeyDown="UrlTextBox_KeyDown"/>

                        <ComboBox
                            x:Name="EnvironmentCombo"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            DisplayMemberPath="Name"
                            ToolTip="Environment (variables {{key}})"/>

                        <Button
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Margin="6,0,0,0"
                            ToolTip="Add an environment (opens the folder)"
                            Click="AddEnvironment_Click">
                            <Path
                                Data="M12,5 L12,19 M5,12 L19,12"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <Button
                            Grid.Column="4"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Margin="4,0,0,0"
                            ToolTip="Edit the variables of the selected environment"
                            Click="EditEnvironment_Click">
                            <Path
                                Data="M4,20 L4,16 L15,5 A2,2 0 0 1 18,5 L19,6 A2,2 0 0 1 19,9 L8,20 Z"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <Button
                            Grid.Column="5"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Margin="4,0,0,0"
                            ToolTip="Reload environments"
                            Click="ReloadEnvironments_Click">
                            <Path
                                Data="M20,11 A8,8 0 1 0 18.5,15.5 M20,5 L20,11 L14,11"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                ToolTip="Open the technical code label file (ValueLabels.json) for the Cards view"
                                Click="OpenValueLabels_Click">
                                <Path
                                    Data="M3,12 L12,3 L19,3 L19,10 L10,19 L3,12 Z M15,7 A1.4,1.4 0 1 0 15,7.01"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="12" Height="12" Stretch="Uniform"/>
                            </Button>

                            <Path
                                x:Name="ValueLabelsWarningText"
                                Data="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,17 L12,17.2"
                                Stroke="{StaticResource DangerBrush}"
                                StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                Width="15" Height="15" Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Visibility="Collapsed"/>
                        </StackPanel>

                        <Button
                            x:Name="SendButton"
                            Grid.Column="7"
                            Margin="10,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SendButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M3,12 L21,3 L14,21 L11,13 Z"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="12" Height="12" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Send" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                        <Path
                            Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M12,16 L12,11 M12,8 L12,8.2"
                            Stroke="{StaticResource TextMutedBrush}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                            Width="11" Height="11" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}">
                            Type <Run FontFamily="Cascadia Code, Consolas" Text="{}{{variable_name}}"/> anywhere in the URL to use a value from the environment selected above.
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Request config: Params / Auth / Headers / Body / Extraction -->
            <Border
                Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,0,0">
                        <RadioButton
                            x:Name="ParamsTabRadio"
                            Content="Params"
                            GroupName="RequestConfigTab"
                            IsChecked="True"
                            Checked="RequestConfigTab_Changed"
                            Style="{StaticResource RequestTabRadioButtonStyle}"/>
                        <RadioButton
                            x:Name="AuthTabRadio"
                            Content="Auth"
                            GroupName="RequestConfigTab"
                            Checked="RequestConfigTab_Changed"
                            Style="{StaticResource RequestTabRadioButtonStyle}"/>
                        <RadioButton
                            x:Name="HeadersTabRadio"
                            GroupName="RequestConfigTab"
                            Checked="RequestConfigTab_Changed"
                            Style="{StaticResource RequestTabRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Headers" Margin="0,0,6,0"/>
                                <Border
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Padding="6,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding ItemsSource.Count, ElementName=HeadersGrid}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AccentPressedBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="BodyTabRadio"
                            Content="Body"
                            GroupName="RequestConfigTab"
                            Checked="RequestConfigTab_Changed"
                            Style="{StaticResource RequestTabRadioButtonStyle}"/>
                        <RadioButton
                            x:Name="ExtractionTabRadio"
                            Content="Extraction"
                            GroupName="RequestConfigTab"
                            Checked="RequestConfigTab_Changed"
                            Style="{StaticResource RequestTabRadioButtonStyle}"/>
                    </StackPanel>
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <Grid>

                            <!-- Params -->
                            <StackPanel x:Name="ParamsTabContent">
                                <TextBlock
                                    Text="Extra parameters appended to the end of the URL (after the ?)."
                                    FontSize="11"
                                    Margin="0,0,0,10"
                                    Foreground="{StaticResource TextMutedBrush}"/>

                                <Button
                                    HorizontalAlignment="Right"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,0,0,6"
                                    ToolTip="Add a row"
                                    Content="+"
                                    Click="AddParamRow_Click"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180" MinHeight="60"/>
                                        <RowDefinition Height="6"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid
                                        x:Name="ParamsGrid"
                                        Grid.Row="0"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="True"
                                        CanUserDeleteRows="True"
                                        HeadersVisibility="Column"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        RowHeight="38"
                                        LostFocus="ParamsGrid_LostFocus">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn
                                                Header="On"
                                                Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="Auto"/>

                                            <DataGridTextColumn
                                                Header="Key"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                Width="2*"
                                                MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Key}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Header="Value"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                Width="3*"
                                                MinWidth="200">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Value}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Width="34">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            ToolTip="Delete this row"
                                                            Content="✕"
                                                            Click="DeleteHeaderItemRow_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <GridSplitter
                                        Grid.Row="1"
                                        Height="6"
                                        HorizontalAlignment="Stretch"
                                        ResizeBehavior="PreviousAndCurrent"
                                        ResizeDirection="Rows"
                                        ToolTip="Drag to resize"/>
                                </Grid>
                            </StackPanel>

                            <!-- Auth -->
                            <StackPanel x:Name="AuthTabContent" Visibility="Collapsed">
                                <TextBlock
                                    Text="How this request proves its identity to the server."
                                    FontSize="11"
                                    Margin="0,0,0,10"
                                    Foreground="{StaticResource TextMutedBrush}"/>

                                <ComboBox
                                    x:Name="AuthTypeCombo"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    SelectedIndex="0"
                                    SelectionChanged="AuthTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Inherit auth from parent"/>
                                    <ComboBoxItem Content="No Auth"/>
                                    <ComboBoxItem Content="Bearer Token"/>
                                    <ComboBoxItem Content="Basic Auth"/>
                                    <ComboBoxItem Content="API Key"/>
                                </ComboBox>

                                <TextBlock
                                    x:Name="InheritAuthPanel"
                                    Margin="0,10,0,0"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="The authorization header will be computed at send time from the authentication defined on the parent folder or collection (right-click it &#8594; «Edit authentication»)."/>

                                <StackPanel
                                    x:Name="BearerAuthPanel"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Text="Token"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>
                                    <TextBox x:Name="BearerTokenTextBox" TextChanged="AuthField_Changed"/>
                                </StackPanel>

                                <StackPanel
                                    x:Name="BasicAuthPanel"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Text="Username"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>
                                    <TextBox x:Name="BasicUsernameTextBox" Margin="0,0,0,8" TextChanged="AuthField_Changed"/>
                                    <TextBlock
                                        Text="Password"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="BasicPasswordBox" PasswordChanged="AuthField_Changed"/>
                                </StackPanel>

                                <StackPanel
                                    x:Name="ApiKeyAuthPanel"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Text="Header Name"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>
                                    <TextBox
                                        x:Name="ApiKeyNameTextBox"
                                        Text="X-API-Key"
                                        Margin="0,0,0,8"
                                        TextChanged="AuthField_Changed"/>
                                    <TextBlock
                                        Text="Value"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>
                                    <TextBox x:Name="ApiKeyValueTextBox" TextChanged="AuthField_Changed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Headers -->
                            <StackPanel x:Name="HeadersTabContent" Visibility="Collapsed">
                                <TextBlock
                                    Text="Extra metadata sent with the request (authentication tokens, content format, custom flags...)."
                                    FontSize="11"
                                    Margin="0,0,0,10"
                                    Foreground="{StaticResource TextMutedBrush}"/>

                                <Button
                                    HorizontalAlignment="Right"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,0,0,6"
                                    ToolTip="Add a row"
                                    Content="+"
                                    Click="AddHeaderRow_Click"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="220" MinHeight="60"/>
                                        <RowDefinition Height="6"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid
                                        x:Name="HeadersGrid"
                                        Grid.Row="0"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="True"
                                        CanUserDeleteRows="True"
                                        HeadersVisibility="Column"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        RowHeight="38"
                                        LostFocus="HeadersGrid_LostFocus">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn
                                                Header="On"
                                                Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="Auto"/>

                                            <DataGridTextColumn
                                                Header="Key"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                Width="2*"
                                                MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Key}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Header="Value"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                Width="3*"
                                                MinWidth="200">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Value}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Width="34">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            ToolTip="Delete this row"
                                                            Content="✕"
                                                            Click="DeleteHeaderItemRow_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <GridSplitter
                                        Grid.Row="1"
                                        Height="6"
                                        HorizontalAlignment="Stretch"
                                        ResizeBehavior="PreviousAndCurrent"
                                        ResizeDirection="Rows"
                                        ToolTip="Drag to resize"/>
                                </Grid>

                                <Border
                                    Margin="0,14,0,0"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Path
                                                    Data="M4,4 L20,4 L20,20 L4,20 Z M4,9 L20,9"
                                                    Stroke="{StaticResource TextSecondaryBrush}"
                                                    StrokeThickness="1.6" StrokeLineJoin="Round"
                                                    Width="12" Height="12" Stretch="Uniform"
                                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock
                                                    Text="Headers added automatically"
                                                    FontSize="11.5"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock
                                                x:Name="ToggleAutoHeadersText"
                                                Grid.Column="1"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource AccentBrush}"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Text="Hide"
                                                MouseLeftButtonDown="ToggleAutoHeaders_MouseLeftButtonDown"/>
                                        </Grid>

                                        <TextBlock
                                            Margin="0,4,0,10"
                                            FontSize="10.5"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="KubaToolKit adds these technical headers automatically when sending — read-only, nothing to do here."/>

                                        <Grid x:Name="AutoHeadersGridContainer">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="200" MinHeight="60"/>
                                                <RowDefinition Height="6"/>
                                            </Grid.RowDefinitions>

                                            <DataGrid
                                                x:Name="AutoHeadersGrid"
                                                Grid.Row="0"
                                                IsReadOnly="True"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                CanUserDeleteRows="False"
                                                HeadersVisibility="Column"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                RowHeight="34"
                                                Background="Transparent">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Header="Key"
                                                        Binding="{Binding Key}"
                                                        Width="2*"
                                                        MinWidth="160"/>

                                                    <DataGridTextColumn
                                                        Header="Value"
                                                        Binding="{Binding Value}"
                                                        Width="3*"
                                                        MinWidth="200"/>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <GridSplitter
                                                Grid.Row="1"
                                                Height="6"
                                                HorizontalAlignment="Stretch"
                                                ResizeBehavior="PreviousAndCurrent"
                                                ResizeDirection="Rows"
                                                ToolTip="Drag to resize"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Body -->
                            <StackPanel x:Name="BodyTabContent" Visibility="Collapsed">
                                <TextBlock
                                    Text="The data sent with the request (mainly for POST/PUT/PATCH)."
                                    FontSize="11"
                                    Margin="0,0,0,10"
                                    Foreground="{StaticResource TextMutedBrush}"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton
                                        x:Name="BodyNoneRadio"
                                        Content="none"
                                        Tag="None"
                                        GroupName="BodyMode"
                                        Checked="BodyMode_Checked"
                                        Style="{StaticResource BodyModeChipStyle}"/>

                                    <RadioButton
                                        x:Name="BodyRawRadio"
                                        Content="raw"
                                        Tag="Text / JSON"
                                        GroupName="BodyMode"
                                        IsChecked="True"
                                        Checked="BodyMode_Checked"
                                        Style="{StaticResource BodyModeChipStyle}"/>

                                    <RadioButton
                                        x:Name="BodyFormDataRadio"
                                        Content="form-data"
                                        Tag="Form fields"
                                        GroupName="BodyMode"
                                        Checked="BodyMode_Checked"
                                        Style="{StaticResource BodyModeChipStyle}"/>

                                    <RadioButton
                                        x:Name="BodyUrlEncodedRadio"
                                        Content="x-www-form-urlencoded"
                                        Tag="URL-encoded form"
                                        GroupName="BodyMode"
                                        Checked="BodyMode_Checked"
                                        Style="{StaticResource BodyModeChipStyle}"/>

                                    <RadioButton
                                        x:Name="BodyBinaryRadio"
                                        Content="binary"
                                        Tag="File"
                                        GroupName="BodyMode"
                                        Checked="BodyMode_Checked"
                                        Style="{StaticResource BodyModeChipStyle}"/>

                                    <RadioButton
                                        x:Name="BodyGraphQlRadio"
                                        Content="GraphQL"
                                        Tag="GraphQL"
                                        GroupName="BodyMode"
                                        Checked="BodyMode_Checked"
                                        Style="{StaticResource BodyModeChipStyle}"/>
                                </WrapPanel>

                                <!-- none -->
                                <TextBlock
                                    x:Name="BodyNonePanel"
                                    Text="This request has no body."
                                    FontStyle="Italic"
                                    Margin="0,6,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Visibility="Collapsed"/>

                                <StackPanel
                                    x:Name="BodyFormPanel"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                                    <Button
                                        HorizontalAlignment="Right"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        Margin="0,0,0,6"
                                        ToolTip="Add a row"
                                        Content="+"
                                        Click="AddBodyFormRow_Click"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="220" MinHeight="60"/>
                                            <RowDefinition Height="6"/>
                                        </Grid.RowDefinitions>

                                        <DataGrid
                                            x:Name="BodyFormGrid"
                                            Grid.Row="0"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="True"
                                            CanUserDeleteRows="True"
                                            HeadersVisibility="Column"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Auto"
                                            RowHeight="38">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn
                                                    Header="On"
                                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="Auto"/>

                                                <DataGridTextColumn
                                                    Header="Key"
                                                    Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                    CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                    Width="2*"
                                                    MinWidth="160">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="{Binding Key}"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn
                                                    Header="Value"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                    CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                    Width="3*"
                                                    MinWidth="200">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="{Binding Value}"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Width="34">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Width="24"
                                                                Height="24"
                                                                Padding="0"
                                                                ToolTip="Delete this row"
                                                                Content="✕"
                                                                Click="DeleteHeaderItemRow_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <GridSplitter
                                            Grid.Row="1"
                                            Height="6"
                                            HorizontalAlignment="Stretch"
                                            ResizeBehavior="PreviousAndCurrent"
                                            ResizeDirection="Rows"
                                            ToolTip="Drag to resize"/>
                                    </Grid>
                                </StackPanel>

                                <!-- raw -->
                                <StackPanel x:Name="BodyRawPanel" Margin="0,6,0,0">
                                    <ComboBox
                                        x:Name="RawContentTypeCombo"
                                        Width="140"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8"
                                        SelectedIndex="1"
                                        SelectionChanged="RawContentTypeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Text"/>
                                        <ComboBoxItem Content="JSON"/>
                                        <ComboBoxItem Content="JavaScript"/>
                                        <ComboBoxItem Content="HTML"/>
                                        <ComboBoxItem Content="XML"/>
                                    </ComboBox>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="220" MinHeight="80"/>
                                            <RowDefinition Height="6"/>
                                        </Grid.RowDefinitions>

                                        <TextBox
                                            x:Name="BodyTextBox"
                                            Grid.Row="0"
                                            AcceptsReturn="True"
                                            AcceptsTab="True"
                                            TextWrapping="NoWrap"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto"
                                            FontFamily="Cascadia Code, Consolas"
                                            FontSize="13"
                                            TextChanged="BodyTextBox_TextChanged"/>

                                        <GridSplitter
                                            Grid.Row="1"
                                            Height="6"
                                            HorizontalAlignment="Stretch"
                                            ResizeBehavior="PreviousAndCurrent"
                                            ResizeDirection="Rows"
                                            ToolTip="Drag to resize"/>
                                    </Grid>
                                </StackPanel>

                                <!-- binary -->
                                <StackPanel
                                    x:Name="BodyBinaryPanel"
                                    Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                                    <Button
                                        Padding="10,6"
                                        Margin="0,0,10,0"
                                        Content="Select a file"
                                        Click="SelectBinaryFile_Click"/>

                                    <TextBlock
                                        x:Name="BinaryFilePathText"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="No file selected"/>
                                </StackPanel>

                                <!-- GraphQL -->
                                <StackPanel
                                    x:Name="BodyGraphQlPanel"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Text="Query"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>

                                    <TextBox
                                        x:Name="GraphQlQueryTextBox"
                                        AcceptsReturn="True"
                                        AcceptsTab="True"
                                        TextWrapping="NoWrap"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="13"
                                        MinHeight="120"
                                        MaxHeight="200"
                                        Margin="0,0,0,10"
                                        TextChanged="GraphQlQueryTextBox_TextChanged"/>

                                    <TextBlock
                                        Text="Variables (JSON)"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,4"/>

                                    <TextBox
                                        x:Name="GraphQlVariablesTextBox"
                                        AcceptsReturn="True"
                                        AcceptsTab="True"
                                        TextWrapping="NoWrap"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="13"
                                        MinHeight="80"
                                        MaxHeight="150"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- Extraction to Environment -->
                            <StackPanel x:Name="ExtractionTabContent" Visibility="Collapsed">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="After a successful send, copies a top-level field of the JSON response into a variable of the selected environment (creates it if needed)."/>

                                <Button
                                    HorizontalAlignment="Right"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,0,0,6"
                                    ToolTip="Add a rule"
                                    Content="+"
                                    Click="AddExtractionRow_Click"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" MinHeight="60"/>
                                        <RowDefinition Height="6"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid
                                        x:Name="ExtractionsGrid"
                                        Grid.Row="0"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="True"
                                        CanUserDeleteRows="True"
                                        HeadersVisibility="Column"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        RowHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn
                                                Header="On"
                                                Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="Auto"/>

                                            <DataGridTextColumn
                                                Header="JSON Field (response)"
                                                Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                Width="2*"
                                                MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Key}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn
                                                Header="Environment Variable"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource EditableDataGridCellStyle}"
                                                Width="3*"
                                                MinWidth="200">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Value}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Width="34">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            ToolTip="Delete this row"
                                                            Content="✕"
                                                            Click="DeleteHeaderItemRow_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <GridSplitter
                                        Grid.Row="1"
                                        Height="6"
                                        HorizontalAlignment="Stretch"
                                        ResizeBehavior="PreviousAndCurrent"
                                        ResizeDirection="Rows"
                                        ToolTip="Drag to resize"/>
                                </Grid>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Row="2"
                Height="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Rows"
                ToolTip="Drag to resize"/>

            <!-- Response -->
            <Border
                Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}"
                Padding="{StaticResource CardPadding}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock
                                Text="Response"
                                FontWeight="Bold"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalAlignment="Center"/>

                            <Border
                                x:Name="StatusBadge"
                                Margin="10,0,0,0"
                                Padding="9,3"
                                CornerRadius="{StaticResource RadiusPill}"
                                Background="{StaticResource SurfaceAltBrush}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="StatusDot"
                                        Width="6" Height="6"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock
                                        x:Name="StatusTextBlock"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                x:Name="TimingTextBlock"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"/>

                            <ProgressBar
                                x:Name="SendProgressBar"
                                Width="140"
                                Margin="10,0,0,0"
                                IsIndeterminate="True"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox
                                x:Name="ResponseSearchBox"
                                Width="150"
                                Height="24"
                                FontSize="11"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                ToolTip="Search in the response (Enter: next, Shift+Enter: previous, Esc: clear)"
                                TextChanged="ResponseSearchBox_TextChanged"
                                PreviewKeyDown="ResponseSearchBox_PreviewKeyDown"/>

                            <TextBlock
                                x:Name="ResponseSearchCountText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="6,0,0,0"
                                Visibility="Collapsed"/>

                            <Button
                                x:Name="ResponseSearchPrevButton"
                                Content="▲"
                                Click="ResponseSearchPrev_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="6,0"
                                Height="22"
                                FontSize="9"
                                Margin="6,0,0,0"
                                Visibility="Collapsed"/>

                            <Button
                                x:Name="ResponseSearchNextButton"
                                Content="▼"
                                Click="ResponseSearchNext_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="6,0"
                                Height="22"
                                FontSize="9"
                                Margin="2,0,16,0"
                                Visibility="Collapsed"/>

                            <Button
                                x:Name="PrevPageButton"
                                Content="◀ Previous"
                                Click="PrevPage_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="8,0"
                                Height="24"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"/>

                            <TextBlock
                                x:Name="PageInfoTextBlock"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"/>

                            <Button
                                x:Name="NextPageButton"
                                Content="Next ▶"
                                Click="NextPage_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="8,0"
                                Height="24"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"/>

                            <TextBlock
                                x:Name="PageSizeLabel"
                                Text="Size"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,4,0"
                                Visibility="Collapsed"/>

                            <TextBox
                                x:Name="PageSizeBox"
                                Width="42"
                                Height="22"
                                FontSize="11"
                                Padding="4,0"
                                VerticalContentAlignment="Center"
                                ToolTip="Page size (Enter to apply)"
                                Margin="0,0,10,0"
                                KeyDown="PageSizeBox_KeyDown"
                                LostFocus="PageSizeBox_LostFocus"
                                Visibility="Collapsed"/>

                            <Button
                                x:Name="SortToggleButton"
                                Click="SortToggle_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="8,0"
                                Height="24"
                                FontSize="11"
                                Margin="0,0,16,0"
                                Visibility="Collapsed"/>

                            <Border
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="ResponseViewCardsRadio"
                                        Content="Cards"
                                        GroupName="ResponseView"
                                        IsChecked="True"
                                        Checked="ResponseViewMode_Changed"
                                        Style="{StaticResource NavPillRadioButtonStyle}"
                                        FontSize="11"
                                        Padding="12,4"/>

                                    <RadioButton
                                        x:Name="ResponseViewRawRadio"
                                        Content="Raw"
                                        GroupName="ResponseView"
                                        Checked="ResponseViewMode_Changed"
                                        Style="{StaticResource NavPillRadioButtonStyle}"
                                        FontSize="11"
                                        Padding="12,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Expander
                        Grid.Row="1"
                        Header="Response Headers"
                        IsExpanded="False"
                        Margin="0,0,0,10">
                        <TextBox
                            x:Name="ResponseHeadersTextBox"
                            Margin="0,10,0,0"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            MaxHeight="150"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Cascadia Code, Consolas"
                            FontSize="12"/>
                    </Expander>

                    <Grid Grid.Row="2">
                        <avalonedit:TextEditor
                            x:Name="ResponseBodyEditor"
                            FontFamily="Cascadia Code, Consolas"
                            FontSize="13"
                            ShowLineNumbers="True"
                            IsReadOnly="True"
                            WordWrap="False"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Padding="8"
                            Visibility="Collapsed"/>

                        <Grid x:Name="ResponsePrettyContainer">
                            <ScrollViewer
                                x:Name="ResponsePrettyScroll"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                behaviors:ScrollSpeedBehavior.LinesPerNotch="8"
                                Padding="4">
                                <ContentControl x:Name="ResponsePrettyContent"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
