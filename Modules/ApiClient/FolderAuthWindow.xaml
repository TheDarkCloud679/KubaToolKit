<Window
    x:Class="KubaToolKit.Modules.ApiClient.FolderAuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Authentication"
    Width="520"
    Height="680"
    MinWidth="420"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="TitleText"
            Grid.Row="0"
            FontWeight="Bold"
            FontSize="15"
            Foreground="{StaticResource TextPrimaryBrush}"
            Margin="0,0,0,14"
            TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1">
            <ComboBox
                x:Name="AuthTypeCombo"
                Width="220"
                HorizontalAlignment="Left"
                SelectionChanged="AuthTypeCombo_SelectionChanged">
                <ComboBoxItem Content="Inherit auth from parent"/>
                <ComboBoxItem Content="No Auth"/>
                <ComboBoxItem Content="Bearer Token"/>
                <ComboBoxItem Content="Basic Auth"/>
                <ComboBoxItem Content="API Key"/>
            </ComboBox>

            <TextBlock
                x:Name="InheritAuthPanel"
                Margin="0,10,0,0"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="Inherits the parent folder or collection's authentication, if any."/>

            <StackPanel
                x:Name="BearerAuthPanel"
                Margin="0,10,0,0"
                Visibility="Collapsed">
                <TextBlock
                    Text="Token"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,4"/>
                <TextBox x:Name="BearerTokenTextBox"/>
            </StackPanel>

            <StackPanel
                x:Name="BasicAuthPanel"
                Margin="0,10,0,0"
                Visibility="Collapsed">
                <TextBlock
                    Text="Username"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,4"/>
                <TextBox x:Name="BasicUsernameTextBox" Margin="0,0,0,8"/>
                <TextBlock
                    Text="Password"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,4"/>
                <PasswordBox x:Name="BasicPasswordBox"/>
            </StackPanel>

            <StackPanel
                x:Name="ApiKeyAuthPanel"
                Margin="0,10,0,0"
                Visibility="Collapsed">
                <TextBlock
                    Text="Header Name"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,4"/>
                <TextBox
                    x:Name="ApiKeyNameTextBox"
                    Text="X-API-Key"
                    Margin="0,0,0,8"/>
                <TextBlock
                    Text="Value"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,4"/>
                <TextBox x:Name="ApiKeyValueTextBox"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Default Headers"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextSecondaryBrush}"
                Margin="0,0,0,4"
                ToolTip="Merged with each request's own headers; closer folders and the request itself win conflicts."/>

            <Border
                Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource SurfaceBrush}"
                Padding="8">

                <DataGrid
                    x:Name="DefaultHeadersGrid"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    CanUserDeleteRows="True"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Auto"
                    RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Header="On"
                            Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                            Width="Auto"/>

                        <DataGridTextColumn
                            Header="Key"
                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource EditableDataGridCellStyle}"
                            Width="1.4*"
                            MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Key}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Header="Value"
                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                            CellStyle="{StaticResource EditableDataGridCellStyle}"
                            Width="2*"
                            MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Value}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        ToolTip="Delete this row"
                                        Click="DeleteDefaultHeaderRow_Click">
                                        <Path
                                            Data="M6,6 L18,18 M18,6 L6,18"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                            Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">

            <Button
                Width="100"
                Margin="0,0,8,0"
                Content="Cancel"
                Click="CancelButton_Click"/>

            <Button
                Width="100"
                Style="{StaticResource AccentButtonStyle}"
                Content="Save"
                Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
