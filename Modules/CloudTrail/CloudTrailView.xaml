<UserControl
    x:Class="KubaToolKit.Modules.CloudTrail.CloudTrailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:KubaToolKit.Shared.Converters">

    <UserControl.Resources>
        <converters:TimestampPartConverter x:Key="TimestampPartConverter"/>
    </UserControl.Resources>

    <Grid x:Name="ResultsPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Progress -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ProgressTextBlock"
                Grid.Column="0"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource TextSecondaryBrush}"/>
            <ProgressBar
                x:Name="SearchProgressBar"
                Grid.Column="1"
                Margin="16,0,4,0"
                Minimum="0"
                Maximum="100"
                Value="0"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- Results, grouped by AWS service (EventSource) -->
        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="True">
                <ItemsControl x:Name="EventsGroupedItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander
                                IsExpanded="False"
                                Margin="0,0,0,8">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            Padding="7,2"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Background="{StaticResource AccentSoftBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource AccentPressedBrush}"
                                                Text="{Binding Count, StringFormat={}{0} events}"/>
                                        </Border>
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Text="{Binding EventSource}"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            Foreground="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <DataGrid
                                    ItemsSource="{Binding Events}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    HeadersVisibility="Column"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    Margin="0,6,0,0"
                                    MaxHeight="350"
                                    RowHeight="48"
                                    MouseDoubleClick="EventsDataGrid_DoubleClick"
                                    HorizontalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn
                                            Header="Timestamp"
                                            Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding Timestamp, Converter={StaticResource TimestampPartConverter}, ConverterParameter=date}"
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock
                                                            Text="{Binding Timestamp, Converter={StaticResource TimestampPartConverter}}"
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn
                                            Header="Event"
                                            Binding="{Binding EventName}"
                                            Width="Auto"
                                            FontWeight="SemiBold"/>
                                        <DataGridTextColumn
                                            Header="User"
                                            Binding="{Binding Username}"
                                            Width="Auto"/>
                                        <DataGridTemplateColumn
                                            Header="Resources"
                                            Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border
                                                            Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,5"
                                                            Margin="0,4"
                                                            MaxHeight="42">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Resources}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock
                                                                Text="{Binding Resources}"
                                                                FontFamily="Cascadia Code, Consolas"
                                                                FontSize="12"
                                                                TextWrapping="Wrap"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock
                                                            Text="—"
                                                            FontSize="12"
                                                            Margin="8,0,0,0"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Resources}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
