<Window
    x:Class="KubaToolKit.Modules.TableViewer.TableViewerSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Table Viewer Settings"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock
            Text="QTable.exe location"
            FontWeight="SemiBold"
            Margin="0,0,0,4"/>
        <TextBlock
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,6"
            Foreground="{StaticResource TextMutedBrush}"
            Text="Local install of the external QTable tool used to open and decode binary table files."/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QTableExePathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button
                Grid.Column="1"
                Content="Browse..."
                Width="90"
                Click="BrowseButton_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
