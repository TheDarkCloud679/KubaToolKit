<Window
    x:Class="KubaToolKit.Modules.TableViewer.TableViewerSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Table Viewer Settings"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock
            Text="XML definitions"
            FontWeight="SemiBold"
            Margin="0,0,0,4"/>
        <TextBlock
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,10"
            Foreground="{StaticResource TextMutedBrush}"
            Text="Same 3 files as QTable's own Parameters dialog -- a file's first 3 letters pick the matching &lt;table&gt; inside whichever of these it's found in."/>

        <TextBlock Text="Tables definitions" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TablesXmlTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Browse..." Width="90" Click="BrowseTablesXml_Click"/>
        </Grid>

        <TextBlock Text="Stats definitions" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="StatsXmlTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Browse..." Width="90" Click="BrowseStatsXml_Click"/>
        </Grid>

        <TextBlock Text="Dumps definitions" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DumpsXmlTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Browse..." Width="90" Click="BrowseDumpsXml_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
