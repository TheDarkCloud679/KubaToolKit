<UserControl
    x:Class="KubaToolKit.Modules.TableViewer.TableViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:KubaToolKit.Modules.TableViewer">

    <UserControl.Resources>
        <local:DepthIndentConverter x:Key="DepthIndentConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Inputs -->
        <Border
            Grid.Row="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Table Viewer"
                        FontWeight="SemiBold"
                        FontSize="14"
                        VerticalAlignment="Center"/>
                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        Padding="0"
                        ToolTip="Settings - Set the XML definitions files"
                        Click="SettingsButton_Click">
                        <Path
                            Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M18,12 L21,12 M16.24,16.24 L18.36,18.36 M12,18 L12,21 M7.76,16.24 L5.64,18.36 M6,12 L3,12 M7.76,7.76 L5.64,5.64 M12,6 L12,3 M16.24,7.76 L18.36,5.64"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Table file(s) -->
                <TextBlock Text="Binary table file(s)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">
                        <ListBox
                            x:Name="TableFilesListBox"
                            Height="56"
                            BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Button
                        x:Name="AddTableFileButton"
                        Grid.Column="1"
                        Width="90"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Content="Add..."
                        ToolTip="Add - Add a file, or every file in a folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddTableFileButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Add file..." Click="AddTableFile_Click"/>
                                <MenuItem Header="Add folder..." Click="AddTableFolder_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="0"
                        VerticalAlignment="Top"
                        ToolTip="Remove - Takes the selected file off this list (doesn't delete it)"
                        Click="RemoveTableFile_Click">
                        <Path
                            Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 A1,1 0 0 0 8,21 L16,21 A1,1 0 0 0 17,20 L18,7"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Button
                    x:Name="DecodeButton"
                    Content="Decode"
                    Width="130"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Decode_Click"/>

                <TextBlock
                    x:Name="StatusText"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                    Foreground="{StaticResource TextSecondaryBrush}"/>

            </StackPanel>
        </Border>

        <!-- Output -->
        <Border
            Grid.Row="2"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid
                    x:Name="ResultsGrid"
                    Grid.Row="0"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        Margin="{Binding Depth, Converter={StaticResource DepthIndentConverter}}"
                                        VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Size (bits)" Binding="{Binding SizeBits}" Width="*"/>
                        <DataGridTextColumn Header="Offset (byte)" Binding="{Binding OffsetBytes}" Width="*"/>
                        <DataGridTextColumn Header="Offset (bit)" Binding="{Binding OffsetBits}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel
                    x:Name="NotesPanel"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                    <ItemsControl x:Name="NotesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>
