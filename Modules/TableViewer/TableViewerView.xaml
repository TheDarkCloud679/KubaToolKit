<UserControl
    x:Class="KubaToolKit.Modules.TableViewer.TableViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Inputs -->
        <Border
            Grid.Row="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Table Viewer"
                        FontWeight="SemiBold"
                        FontSize="14"
                        VerticalAlignment="Center"/>
                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        Padding="0"
                        ToolTip="Settings - Set the QTable.exe location"
                        Click="SettingsButton_Click">
                        <Path
                            Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M18,12 L21,12 M16.24,16.24 L18.36,18.36 M12,18 L12,21 M7.76,16.24 L5.64,18.36 M6,12 L3,12 M7.76,7.76 L5.64,5.64 M12,6 L12,3 M16.24,7.76 L18.36,5.64"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Table file(s) -->
                <TextBlock Text="Binary table file(s)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}">
                        <ListBox
                            x:Name="TableFilesListBox"
                            Height="56"
                            BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Button
                        x:Name="AddTableFileButton"
                        Grid.Column="1"
                        Width="90"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Content="Add..."
                        ToolTip="Add - Add a file, or every file in a folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddTableFileButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Add file..." Click="AddTableFile_Click"/>
                                <MenuItem Header="Add folder..." Click="AddTableFolder_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="0"
                        VerticalAlignment="Top"
                        ToolTip="Remove - Takes the selected file off this list (doesn't delete it)"
                        Click="RemoveTableFile_Click">
                        <Path
                            Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 A1,1 0 0 0 8,21 L16,21 A1,1 0 0 0 17,20 L18,7"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Definition file -->
                <TextBlock Text="Definition file (XML, optional)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="DefinitionFilePathTextBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        IsReadOnly="True"/>
                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseDefinitionFile_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button
                        Content="Open in QTable"
                        Width="130"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenInQTable_Click"/>
                    <Button
                        x:Name="TryExportButton"
                        Content="Try automatic export"
                        Width="160"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="TryExport_Click"/>
                </StackPanel>

                <TextBlock
                    x:Name="CommandPreviewText"
                    FontSize="10"
                    FontFamily="Consolas"
                    TextWrapping="Wrap"
                    Margin="0,0,0,4"
                    Foreground="{StaticResource TextMutedBrush}"/>

                <TextBlock
                    x:Name="StatusText"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource TextSecondaryBrush}"/>

            </StackPanel>
        </Border>

        <!-- Output -->
        <Border
            Grid.Row="2"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Exported content"
                        FontWeight="SemiBold"
                        FontSize="12"
                        VerticalAlignment="Center"/>
                    <Button
                        x:Name="OpenInViewerButton"
                        Grid.Column="1"
                        Content="Open in viewer"
                        Width="110"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="OpenInViewer_Click"/>
                </Grid>

                <TextBox
                    x:Name="OutputTextBox"
                    Grid.Row="1"
                    Style="{StaticResource MultilineTextBoxStyle}"
                    IsReadOnly="True"
                    FontFamily="Consolas"
                    Text="No export yet."/>

            </Grid>
        </Border>

    </Grid>
</UserControl>
