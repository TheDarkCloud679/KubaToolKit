<UserControl
    x:Class="KubaToolKit.Modules.TableViewer.TableViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Inputs -->
        <Border
            Grid.Row="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <StackPanel>

                <TextBlock
                    Text="Table Viewer"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Margin="0,0,0,2"/>
                <TextBlock
                    TextWrapping="Wrap"
                    FontSize="11"
                    Margin="0,0,0,12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="Decodes binary table files with the external QTable tool. Pick the QTable.exe install, the binary file to read, and (optionally) the XML definition file it should use -- then open it directly in QTable, or try an automatic text export below."/>

                <!-- QTable.exe path -->
                <TextBlock Text="QTable.exe location" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="QTableExePathTextBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        LostFocus="QTableExePathTextBox_LostFocus"/>
                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseQTableExe_Click"/>
                </Grid>

                <!-- Table file -->
                <TextBlock Text="Binary table file" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="TableFilePathTextBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        IsReadOnly="True"/>
                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseTableFile_Click"/>
                </Grid>

                <!-- Definition file -->
                <TextBlock Text="Definition file (XML, optional)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="DefinitionFilePathTextBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        IsReadOnly="True"/>
                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        Width="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseDefinitionFile_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button
                        Content="Open in QTable"
                        Width="130"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenInQTable_Click"/>
                    <Button
                        x:Name="TryExportButton"
                        Content="Try automatic export"
                        Width="160"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="TryExport_Click"/>
                </StackPanel>

                <TextBlock
                    x:Name="CommandPreviewText"
                    FontSize="10"
                    FontFamily="Consolas"
                    TextWrapping="Wrap"
                    Margin="0,0,0,4"
                    Foreground="{StaticResource TextMutedBrush}"/>

                <TextBlock
                    x:Name="StatusText"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource TextSecondaryBrush}"/>

            </StackPanel>
        </Border>

        <!-- Output -->
        <Border
            Grid.Row="2"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource SurfaceBrush}"
            Effect="{StaticResource CardShadowEffect}"
            Padding="{StaticResource CardPadding}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="Exported content"
                        FontWeight="SemiBold"
                        FontSize="12"
                        VerticalAlignment="Center"/>
                    <Button
                        x:Name="OpenInViewerButton"
                        Grid.Column="1"
                        Content="Open in viewer"
                        Width="110"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="OpenInViewer_Click"/>
                </Grid>

                <TextBox
                    x:Name="OutputTextBox"
                    Grid.Row="1"
                    Style="{StaticResource MultilineTextBoxStyle}"
                    IsReadOnly="True"
                    FontFamily="Consolas"
                    Text="No export yet."/>

            </Grid>
        </Border>

    </Grid>
</UserControl>
