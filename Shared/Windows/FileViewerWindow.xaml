<Window x:Class="KubaToolKit.Shared.Windows.FileViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="File Viewer"
        Height="800"
        Width="1300"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <!-- Same treatment as JsonViewerWindow (the log viewer popup): this
         card IS the window, so it needs real contrast against the window
         background rather than the shared WindowBackgroundBrush, which is
         only 4% off the card's SurfaceBrush and doesn't read as "floating"
         once compressed into a screenshot. -->
    <Grid Margin="28" Background="#E9E9EB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="{StaticResource CardPadding}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource AccentGradientBrush}">
                    <Path Data="M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7 M8,12 L16,12 M8,15 L16,15 M8,18 L13,18"
                          Stroke="{StaticResource TextOnAccentBrush}"
                          StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="17" Height="17" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                        Style="{StaticResource AccentButtonStyle}" Click="CopyAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="CopyButtonIcon"
                              Data="M8,8 L20,8 L20,20 L8,20 Z M16,8 L16,5 A2,2 0 0 0 14,3 L5,3 A2,2 0 0 0 3,5 L3,14 A2,2 0 0 0 5,16 L8,16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="CopyButtonText" Text="Copy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameTextBlock" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cards / Raw toggle (only shown when the content parses as JSON) -->
        <StackPanel x:Name="ViewModeRow"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="2,0,0,16"
                    Visibility="Collapsed">
            <RadioButton x:Name="CardsViewRadio"
                         Content="Cards"
                         GroupName="FileViewMode"
                         IsChecked="True"
                         Checked="ViewMode_Changed"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"/>
            <RadioButton x:Name="RawViewRadio"
                         Content="Raw"
                         GroupName="FileViewMode"
                         Checked="ViewMode_Changed"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Search -->
        <Border x:Name="SearchPanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Margin="0,0,0,16"
                Padding="{StaticResource CardPadding}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel Orientation="Horizontal">
                <Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M16,16 L21,21"
                      Stroke="{StaticResource TextMutedBrush}"
                      StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      Width="14" Height="14" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchTextBox" Width="260" VerticalAlignment="Center"
                         KeyDown="SearchTextBox_KeyDown"/>
                <Button Content="Previous" Width="80" Margin="10,0,0,0" Click="FindPrevious_Click"/>
                <Button Content="Next" Width="80" Margin="8,0,0,0" Click="FindNext_Click"/>
                <Border Margin="12,0,0,0" Padding="8,3"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SearchCountText" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPressedBrush}" Text="0 / 0"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource TextPrimaryColor}" Direction="270"
                                   ShadowDepth="4" BlurRadius="26" Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <avalonedit:TextEditor
                    x:Name="ContentEditor"
                    FontFamily="Cascadia Code, Consolas"
                    FontSize="14"
                    ShowLineNumbers="True"
                    LineNumbersForeground="{StaticResource TextMutedBrush}"
                    IsReadOnly="True"
                    WordWrap="False"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="16"
                    ContextMenuOpening="ContentEditor_ContextMenuOpening">

                    <avalonedit:TextEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                x:Name="CopySelectedMenuItem"
                                Header="Copy selected"
                                Click="CopySelected_Click"/>

                            <Separator/>

                            <MenuItem
                                Header="Copy all"
                                Click="CopyAll_Click"/>
                        </ContextMenu>
                    </avalonedit:TextEditor.ContextMenu>
                </avalonedit:TextEditor>

                <ScrollViewer
                    x:Name="CardsScrollViewer"
                    Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="16">
                    <ContentControl x:Name="CardsContent"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,14,0,0">
            <Path Data="M3,1 L9,1 L12,4 L12,13 L3,13 Z" Stroke="{StaticResource TextMutedBrush}"
                  StrokeThickness="1.3" StrokeLineJoin="Round"
                  Width="11" Height="11" Stretch="Uniform"
                  VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="FileInfoText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
