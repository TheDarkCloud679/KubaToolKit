<Window x:Class="KubaToolKit.Shared.Windows.JsonViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Log Viewer"
        Height="800"
        Width="1300"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Same override as FileViewerWindow: the shared Expander style's
             left accent bar (Styles/Controls.xaml) is meant for a single
             level of results groups, but the JSON Cards view nests many
             expanders, so several bars stack up. Dropped here only. -->
        <Style TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton
                                    x:Name="HeaderToggle"
                                    DockPanel.Dock="Top"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    OverridesDefaultStyle="True"
                                    Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBd" Background="Transparent" Padding="10,9" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path
                                                        x:Name="Arrow"
                                                        Grid.Column="0"
                                                        Data="M0,0 L4,4 L8,0"
                                                        Stroke="{StaticResource TextSecondaryBrush}"
                                                        StrokeThickness="1.6"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        Width="10"
                                                        Height="6"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="ArrowRotate" Angle="-90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter
                                                        Grid.Column="1"
                                                        Content="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                        VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="-90" Duration="0:0:0.16"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter
                                    x:Name="ExpanderContent"
                                    DockPanel.Dock="Bottom"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="10,0,10,10"
                                    Opacity="0"
                                    Visibility="Collapsed">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="ExpanderContentTranslate" Y="-18"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ExpanderContent"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.45"
                                                EasingFunction="{StaticResource MotionEaseOut}"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ExpanderContentTranslate"
                                                Storyboard.TargetProperty="Y"
                                                To="0"
                                                Duration="0:0:0.45"
                                                EasingFunction="{StaticResource MotionEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Deliberately NOT the shared WindowBackgroundBrush (#F4F4F5): that's
         only 4% darker than the card's SurfaceBrush (#FFFFFF), fine for a
         screen with several cards but here the card IS the window, and a
         4% difference doesn't read as a floating card once compressed
         into a screenshot, so this needs real contrast, local to this window. -->
    <Grid Margin="28" Background="#E9E9EB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header. Wrapped in its own card (not just floating text on the
             window background) for the same reason the JSON pane needed
             real background contrast: a region with no border of its own
             gives the eye nothing to judge "is there margin here" against,
             so it read as flush against the edges no matter how much
             margin the numbers said it had. A crisp boundary makes the
             spacing actually legible, and matches every other bounded
             region in this app being a card. -->
        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="{StaticResource CardPadding}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}"
                Effect="{StaticResource CardShadowEffect}">
            <DockPanel>

                <Border
                    DockPanel.Dock="Left"
                    Width="34"
                    Height="34"
                    Margin="0,0,12,0"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource AccentGradientBrush}">
                    <Path
                        Data="M3,1 L9,1 L12,4 L12,13 L3,13 Z M9,1 L9,4 L12,4 M5,7.2 L10,7.2 M5,9.7 L10,9.7"
                        Stroke="{StaticResource TextOnAccentBrush}"
                        StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="17" Height="17" Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <Button
                    x:Name="CopyButton"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            x:Name="CopyButtonIcon"
                            Data="M8,8 L20,8 L20,20 L8,20 Z M16,8 L16,5 A2,2 0 0 0 14,3 L5,3 A2,2 0 0 0 3,5 L3,14 A2,2 0 0 0 5,16 L8,16"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="14" Height="14" Stretch="Uniform"
                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="CopyButtonText" Text="Copy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="Formatted Log Message"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cards / Raw toggle (only shown when the message parses as JSON) -->
        <StackPanel x:Name="ViewModeRow"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="2,0,0,16"
                    Visibility="Collapsed">
            <RadioButton x:Name="CardsViewRadio"
                         Content="Cards"
                         GroupName="JsonViewMode"
                         Checked="ViewMode_Changed"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"/>
            <RadioButton x:Name="RawViewRadio"
                         Content="Raw"
                         GroupName="JsonViewMode"
                         Checked="ViewMode_Changed"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- JSON. A visibly stronger shadow than the standard CardShadowEffect
             on purpose: this card IS the window (everything else is just
             header/footer chrome around it), so it should read as clearly
             "floating" rather than blending into the window background the
             way a card among several siblings would. -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect
                    Color="{StaticResource TextPrimaryColor}"
                    Direction="270"
                    ShadowDepth="4"
                    BlurRadius="26"
                    Opacity="0.16"/>
            </Border.Effect>

            <Grid>
            <avalonedit:TextEditor
                x:Name="JsonTextBox"
                FontFamily="Cascadia Code, Consolas"
                FontSize="14"
                ShowLineNumbers="True"
                LineNumbersForeground="{StaticResource TextMutedBrush}"
                IsReadOnly="True"
                WordWrap="False"
                Background="Transparent"
                BorderThickness="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Padding="16"/>

            <ScrollViewer
                x:Name="CardsScrollViewer"
                Visibility="Collapsed"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Padding="16">
                <ContentControl x:Name="CardsContent"/>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="2,14,0,0">
            <Path
                Data="M3,1 L9,1 L12,4 L12,13 L3,13 Z"
                Stroke="{StaticResource TextMutedBrush}"
                StrokeThickness="1.3" StrokeLineJoin="Round"
                Width="11" Height="11" Stretch="Uniform"
                VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock
                x:Name="JsonInfoText"
                FontSize="11.5"
                Foreground="{StaticResource TextMutedBrush}"
                VerticalAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
