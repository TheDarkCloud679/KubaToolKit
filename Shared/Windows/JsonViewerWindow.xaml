<Window x:Class="KubaToolKit.Shared.Windows.JsonViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Log Viewer"
        Height="800"
        Width="1300"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <!-- Deliberately NOT the shared WindowBackgroundBrush (#F4F4F5): that's
         only 4% darker than the card's SurfaceBrush (#FFFFFF), fine for a
         screen with several cards but here the card IS the window, and a
         4% difference doesn't read as a floating card once compressed
         into a screenshot, so this needs real contrast, local to this window. -->
    <Grid Margin="28" Background="#E9E9EB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,20">

            <Border
                DockPanel.Dock="Left"
                Width="34"
                Height="34"
                Margin="0,0,12,0"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource AccentGradientBrush}">
                <Path
                    Data="M3,1 L9,1 L12,4 L12,13 L3,13 Z M9,1 L9,4 L12,4 M5,7.2 L10,7.2 M5,9.7 L10,9.7"
                    Stroke="{StaticResource TextOnAccentBrush}"
                    StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="17" Height="17" Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <Button
                x:Name="CopyButton"
                DockPanel.Dock="Right"
                Margin="12,0,0,0"
                Style="{StaticResource AccentButtonStyle}"
                Click="CopyButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Data="M8,8 L20,8 L20,20 L8,20 Z M16,8 L16,5 A2,2 0 0 0 14,3 L5,3 A2,2 0 0 0 3,5 L3,14 A2,2 0 0 0 5,16 L8,16"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="14" Height="14" Stretch="Uniform"
                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Copy" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Text="Formatted Log Message"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- JSON. A visibly stronger shadow than the standard CardShadowEffect
             on purpose: this card IS the window (everything else is just
             header/footer chrome around it), so it should read as clearly
             "floating" rather than blending into the window background the
             way a card among several siblings would. -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect
                    Color="{StaticResource TextPrimaryColor}"
                    Direction="270"
                    ShadowDepth="4"
                    BlurRadius="26"
                    Opacity="0.16"/>
            </Border.Effect>

            <avalonedit:TextEditor
                x:Name="JsonTextBox"
                FontFamily="Cascadia Code, Consolas"
                FontSize="14"
                ShowLineNumbers="True"
                LineNumbersForeground="{StaticResource TextMutedBrush}"
                IsReadOnly="True"
                WordWrap="False"
                Background="Transparent"
                BorderThickness="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Padding="16"/>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="2,14,0,0">
            <Path
                Data="M3,1 L9,1 L12,4 L12,13 L3,13 Z"
                Stroke="{StaticResource TextMutedBrush}"
                StrokeThickness="1.3" StrokeLineJoin="Round"
                Width="11" Height="11" Stretch="Uniform"
                VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock
                x:Name="JsonInfoText"
                FontSize="11.5"
                Foreground="{StaticResource TextMutedBrush}"
                VerticalAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
