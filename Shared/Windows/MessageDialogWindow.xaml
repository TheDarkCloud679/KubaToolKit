<Window x:Class="KubaToolKit.Shared.Windows.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border
                x:Name="IconBadge"
                DockPanel.Dock="Left"
                Width="34" Height="34"
                Margin="0,0,12,0"
                CornerRadius="{StaticResource RadiusMedium}">
                <Path
                    x:Name="IconPath"
                    Stroke="{StaticResource TextOnAccentBrush}"
                    StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="17" Height="17" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock
                x:Name="TitleText"
                FontSize="15"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}"
                VerticalAlignment="Center"
                TextWrapping="Wrap"/>
        </DockPanel>

        <Border
            Grid.Row="1"
            MaxHeight="380"
            Margin="0,0,0,20"
            Background="{StaticResource SurfaceAltBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <TextBox
                    x:Name="MessageTextBox"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="True"
                    BorderThickness="0"
                    Background="Transparent"
                    TextWrapping="Wrap"
                    Cursor="IBeam"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="13"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                x:Name="CancelButton"
                Content="Cancel"
                Width="90"
                Margin="0,0,10,0"
                Visibility="Collapsed"
                Click="CancelButton_Click"/>
            <Button
                x:Name="NoButton"
                Content="No"
                Width="90"
                Margin="0,0,10,0"
                Visibility="Collapsed"
                Click="NoButton_Click"/>
            <Button
                x:Name="YesButton"
                Content="Yes"
                Width="90"
                Margin="0,0,10,0"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed"
                Click="YesButton_Click"/>
            <Button
                x:Name="OkButton"
                Content="OK"
                Width="90"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed"
                Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
