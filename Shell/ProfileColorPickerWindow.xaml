<Window
    x:Class="KubaToolKit.Shell.ProfileColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Profile colors"
    Width="480"
    Height="520"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="Pick a color for any profile you want to stand out -- saved automatically. Profiles left on &quot;Auto&quot; keep the naming-based guess."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse
                                                Width="24" Height="24"
                                                Margin="0,0,8,8"
                                                Cursor="Hand"
                                                Fill="{Binding Fill}"
                                                Stroke="{Binding RingBrush}"
                                                StrokeThickness="{Binding RingThickness}"
                                                ToolTip="{Binding ToolTipText}"
                                                MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            Content="Close"
            Width="90"
            HorizontalAlignment="Right"
            Margin="0,12,0,0"
            Style="{StaticResource AccentButtonStyle}"
            Click="Close_Click"/>
    </Grid>
</Window>
