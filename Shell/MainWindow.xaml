<Window
    x:Class="KubaToolKit.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:KubaToolKit.Shared.Behaviors"
    xmlns:local="clr-namespace:KubaToolKit.Shell"
    Title="KubaToolKit"
    Height="780"
    Width="1400"
    MinHeight="700"
    MinWidth="1200"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ProfileRiskBrushConverter x:Key="ProfileRiskBrushConverter"/>
    </Window.Resources>

    <Grid Margin="12" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>

            <!-- Filters -->
            <RowDefinition Height="Auto"/>

            <!-- Splitter -->
            <RowDefinition Height="6"/>

            <!-- Active module -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="0"
            Padding="16,14"
            Margin="0,0,0,10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Background="{StaticResource HeaderBrush}"
            Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">
                    <Border
                        Width="34"
                        Height="34"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource BrandGradientBrush}"
                        Effect="{StaticResource CardShadowEffect}">
                        <TextBlock
                            Text="K"
                            FontWeight="Bold"
                            FontSize="16"
                            Foreground="{StaticResource TextOnAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Text="KubaToolKit"
                                FontWeight="Bold"
                                FontSize="16"
                                Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock
                                x:Name="VersionTextBlock"
                                FontSize="10"
                                Margin="6,0,0,2"
                                VerticalAlignment="Bottom"
                                Foreground="{StaticResource TextMutedBrush}"
                                ToolTip="KubaToolKit Version"/>
                        </StackPanel>
                        <TextBlock
                            Text="AWS Ops &amp; API Toolkit"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Button
                    x:Name="TeamSharingButton"
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="Team Sharing..."
                    ToolTip="Share the incident Library, Wiki, and API Client collections with your team via a synced folder (Google Drive, OneDrive...)"
                    Click="TeamSharingButton_Click"/>

                <!-- Module switcher: pill-highlighted radio labels
                     (NavPillRadioButtonStyle) directly on the header, no
                     enclosing track: the header card is already a rounded
                     surface, and a second rounded container just for the
                     nav on top of it read as nested-rounded-rectangle
                     clutter rather than a clean segmented control. Same
                     RadioButton/GroupName/Checked wiring underneath. -->
                <WrapPanel
                    Grid.Row="1"
                    Margin="0,0,0,12">
                        <RadioButton
                            x:Name="DashboardModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            IsChecked="True"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M0.5,0.5 H6.5 V6.5 H0.5 Z M9.5,0.5 H15.5 V6.5 H9.5 Z M0.5,9.5 H6.5 V15.5 H0.5 Z M9.5,9.5 H15.5 V15.5 H9.5 Z"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.4"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="CloudWatchModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M0.5,9 L4,9 L6,3.5 L9.5,13.5 L11.5,9 L15.5,9"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="CloudWatch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="CloudTrailModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M1,3 H15 M1,8 H15 M1,13 H10"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="CloudTrail" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="S3ModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M1,3.5 L6,3.5 L7.5,5.5 L15,5.5 L15,13 L1,13 Z"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.4" StrokeLineJoin="Round"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="S3 Explorer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="SqsModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M1,4 H15 V12 H1 Z M1,4 L8,9.5 L15,4"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.4" StrokeLineJoin="Round"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="SQS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="StepFunctionsModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M3,13 L3,8 L8,8 L8,3 M8,8 L13,8 L13,13"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Step Functions" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="ApiClientModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M5,3 L1.5,8 L5,13 M11,3 L14.5,8 L11,13"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Width="14" Height="14" Stretch="Uniform"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="API Client" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            x:Name="AtlassianSearchModeRadio"
                            Style="{StaticResource NavPillRadioButtonStyle}"
                            GroupName="Mode"
                            Checked="ModeRadio_Checked"
                            Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse
                                        Width="9" Height="9" Margin="0,0,5,5"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        StrokeThickness="1.5"/>
                                    <Line
                                        X1="9" Y1="9" X2="14" Y2="14"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <TextBlock Text="Atlassian" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                </WrapPanel>

                <Grid
                    x:Name="ProfilePatternSearchRow"
                    Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ProfileGroup" Grid.Column="0" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Profile"/>

                        <Button
                            x:Name="ProfileColorButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Margin="6,0,0,0"
                            Content="🎨"
                            ToolTip="Assign colors to profiles"
                            Click="ProfileColorButton_Click"/>

                        <ComboBox
                            x:Name="ProfileCombo"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            SelectionChanged="ProfileCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="7" Height="7"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Converter={StaticResource ProfileRiskBrushConverter}}"
                                            ToolTip="Best-effort guess from the profile's name -- red usually means production"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="PatternGroup" Grid.Column="1" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Pattern"/>

                        <ComboBox
                            x:Name="PatternCombo"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            SelectionChanged="PatternCombo_SelectionChanged"/>
                    </Grid>

                    <Grid x:Name="AttributeGroup" Grid.Column="1" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Attribute"/>

                        <ComboBox
                            x:Name="CloudTrailAttributeCombo"
                            Grid.Column="1"
                            Margin="6,0,0,0"/>
                    </Grid>

                    <Grid x:Name="SearchGroup" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Search"/>

                        <TextBox
                            x:Name="SearchTextBox"
                            Grid.Column="1"
                            Margin="6,0,12,0"
                            VerticalContentAlignment="Center"
                            KeyDown="SearchTextBox_KeyDown"/>
                    </Grid>

                    <Button
                        x:Name="SearchButton"
                        Grid.Column="3"
                        Width="90"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Search"
                        Click="SearchButton_Click"/>
                </Grid>

                <Grid
                    x:Name="DateRangeRow"
                    Grid.Row="3"
                    Margin="0,12,0,0">

                    <Grid x:Name="DateFieldsGroup" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="0,0,8,0"
                            Text="Start"/>
                        <DatePicker
                            x:Name="StartDatePicker"
                            Grid.Column="1"
                            Width="85"
                            Tag="Start date"
                            VerticalContentAlignment="Center"/>
                        <TextBox
                            x:Name="StartTimeTextBox"
                            Grid.Column="2"
                            Width="70"
                            Margin="8,0,0,0"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            behaviors:TimeEntryBehavior.Enabled="True"/>
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="24,0,8,0"
                            Text="End"/>
                        <DatePicker
                            x:Name="EndDatePicker"
                            Grid.Column="4"
                            Width="85"
                            Tag="End date"
                            VerticalContentAlignment="Center"/>
                        <TextBox
                            x:Name="EndTimeTextBox"
                            Grid.Column="5"
                            Width="70"
                            Margin="8,0,0,0"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            behaviors:TimeEntryBehavior.Enabled="True"/>
                    </Grid>

                    <!-- CloudWatch-only: toggles CloudWatchLogsView's debug
                         query panel. Lives here (not in the module itself)
                         because this whole row is Shell-owned and shared
                         with CloudTrail, same as DateFieldsGroup above. -->
                    <Border
                        x:Name="CloudWatchDebugToggle"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="10,5"
                        CornerRadius="{StaticResource RadiusMedium}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox
                            x:Name="CloudWatchDebugModeCheckBox"
                            Content="Debug mode"
                            FontWeight="SemiBold"
                            Checked="CloudWatchDebugModeCheckBox_Changed"
                            Unchecked="CloudWatchDebugModeCheckBox_Changed"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <GridSplitter
               Grid.Row="1"
               Height="6"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Center"
               ResizeBehavior="PreviousAndNext"
               ResizeDirection="Rows"/>

        <!-- ===================================================== -->
        <!-- ACTIVE MODULE -->
        <!-- ===================================================== -->

        <!-- The header Border above has its own Padding (16,14) giving it
             breathing room; ModuleHost had none beyond the outer window
             Margin, so every module's own top-right content (e.g. the
             Dashboard's toolbar buttons) sat flush against the header/
             splitter above and the window's right edge. -->
        <Grid
            x:Name="ModuleHost"
            Grid.Row="2"
            Margin="0,12,8,0"/>
    </Grid>
</Window>
