<Window
    x:Class="KubaToolKit.Shell.TeamSharingSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Team Sharing"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock
            Text="Shared folder (optional)"
            FontWeight="SemiBold"
            Margin="0,0,0,4"/>
        <TextBlock
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,6"
            Foreground="{StaticResource TextMutedBrush}">
            <Run Text="Point this at a folder a sync tool already keeps up to date (Google Drive, OneDrive...) to share the incident Library, the Wiki, and API Client collections with your team automatically -- everyone pointed at the same folder reads and writes the same data. Never used for anything that can hold credentials (API tokens, Environments' auth values), which always stay local. Leave empty to keep everything on this machine only."/>
        </TextBlock>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SharedFolderTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button
                Grid.Column="1"
                Content="Browse..."
                Width="90"
                Click="BrowseButton_Click"/>
        </Grid>

        <TextBlock
            Text="Changes take effect the next time KubaToolKit starts."
            FontSize="11"
            FontStyle="Italic"
            Margin="0,0,0,16"
            Foreground="{StaticResource TextMutedBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
