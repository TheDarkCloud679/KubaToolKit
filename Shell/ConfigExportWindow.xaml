<Window
    x:Class="KubaToolKit.Shell.ConfigExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export / Import Configuration"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,16"
            Foreground="{StaticResource TextMutedBrush}"
            Text="Bundles Collections, Environments, Wiki, Incidents, and Atlassian settings into one file -- no secrets included, and importing never overwrites anything."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                x:Name="ImportButton"
                Content="Import from file..."
                Width="150"
                Margin="0,0,8,0"
                Click="ImportButton_Click"/>
            <Button
                x:Name="ExportButton"
                Content="Export to file..."
                Width="150"
                Style="{StaticResource AccentButtonStyle}"
                Click="ExportButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
